# ---------------------------------------------------------------------------
# direct_url provider environment
#
# docker-compose.yml's `provider-direct-url` service reads this file
# (`env_file: - .env.direct-url`). Uncomment that service block in
# docker-compose.yml to use it, then:
#
#     cp .env.example.direct-url .env.direct-url
#
# The container_name MUST be "tnhcomfy-{PROVIDER_ID}" so the backend can
# detect it (backend_v2/infrastructure/providers/runtime.py). compose already
# sets PROVIDER_ID/PORT/BACKEND_URL/ENGINE in the service `environment:` block,
# which wins over this file — they are repeated here only so the file is
# readable on its own.
#
# Values below are placeholders. NEVER put a real credential in an example
# file: they are committed.
# ---------------------------------------------------------------------------

# Identity. The image_worker Dockerfile has no default baked in, so if you run
# the worker outside compose these three must be set or it falls back to
# "direct_url-worker" and posts discovery to its own loopback forever.
PROVIDER_ID=direct_url
PORT=8000
BACKEND_URL=http://backend_v2:8002

# Which engine module the worker loads.
ENGINE=direct_url

# ---------------------------------------------------------------------------
# Required: where the ComfyUI server actually is
# ---------------------------------------------------------------------------
# Base URL of the ComfyUI instance this provider drives. It is the upstream
# endpoint for every image operation and is also what /health probes
# (GET /system_stats), so a wrong value shows up as an unhealthy provider
# rather than as a silent failure at dispatch time. Often a LAN address.
#
# The container healthcheck deliberately does NOT use it. It calls /live, which
# only reports whether the worker process is serving: a remote ComfyUI that this
# compose file neither manages nor gates going down is a real condition the
# operator and the dispatcher must see, but it is not the worker container
# failing, and treating it as such used to turn `docker compose ps` red and
# cascade into anything depending on the provider.
COMFYUI_URL=http://192.168.1.50:8188

# Optional. Sent as `Authorization: Bearer <key>` on every ComfyUI request.
# Set it when the ComfyUI instance sits behind a reverse proxy that requires
# one; leave empty for a bare LAN instance.
COMFYUI_API_KEY=

# ---------------------------------------------------------------------------
# Model sources used when reconciling against the backend
# ---------------------------------------------------------------------------
# HuggingFace token. Needed for gated/private repos and to raise the rate limit.
HF_TOKEN=
# CivitAI token. Needed for models that require authentication to download.
CIVITAI_TOKEN=

# ---------------------------------------------------------------------------
# Timeouts and worker behaviour (image_worker/worker.py)
# ---------------------------------------------------------------------------
# Seconds a single /inference may run before the worker emits a retryable
# `failed` event. Read as COMFYUI_TIMEOUT_SECONDS at
# `provider_containers/image_worker/worker.py:70`.
#
# This file previously said INFERENCE_TIMEOUT_SECONDS. Nothing has read that
# name anywhere in the repo — the knob exists, under this one — so copying this
# file produced a setting that did nothing.
# COMFYUI_TIMEOUT_SECONDS=3600

# Seconds /validate-models may take before it is abandoned. 300
VALIDATION_TIMEOUT_SECONDS=300

# Per-directory ceiling when listing models for reconciliation. On a remote
# storage backend a single cold listing of a large directory can take a while.
# 3600
RECONCILIATION_LIST_TIMEOUT_SECONDS=3600

# Concurrent model downloads during reconciliation. 5
MAX_CONCURRENT_DOWNLOADS=5

# How often the worker asks the backend to reconcile. 7200 (2 hours)
RECONCILIATION_INTERVAL_SECONDS=7200

# Delay before the first reconciliation after boot, so a restarted stack does
# not immediately fan out to every provider. 130
RECONCILIATION_STARTUP_DELAY_SECONDS=130

# Ceiling on the /health probe of COMFYUI_URL (GET /system_stats). 1.5
#
# This budget belongs to the DISPATCHER, not to the container healthcheck. The
# compose and Dockerfile healthchecks call /live, which does not touch the
# upstream at all, so they are unaffected by this value. But
# backend_v2/services/load_balancer.py:345 and api/routes/providers/crud.py:167
# probe /health with a 2.0s timeout and require HTTP 200 — so a probe slower
# than that reads as "no answer", and a slow-but-healthy ComfyUI is
# indistinguishable from an unreachable one and the provider is excluded from
# dispatch. 1.5s leaves room for the handler to return a definite 503 with a
# real message instead of leaving the caller to time out.
#
# /system_stats is a few hundred bytes and answers in single-digit milliseconds
# on a warm ComfyUI, so 1.5s is a long time for it. A ComfyUI still cold-loading a
# checkpoint can exceed it, and that is a real condition — it cannot take a job
# quickly. Raise it if your ComfyUI is on a slow link and you would rather see a
# timeout than an unhealthy.
COMFYUI_HEALTH_PROBE_TIMEOUT=1.5

# Maximum number of fire-and-forget download/reconciliation tasks a worker will
# hold at once. Past this the request is refused with a retryable 429 rather
# than growing an unbounded set. 16
PROVIDER_MAX_BACKGROUND_TASKS=16

# Ceiling on a single /get-file transfer, in bytes (0 or less disables the cap).
# /get-file serves model sidecars, previews and output images — not checkpoint
# weights. 536870912 (512 MiB)
PROVIDER_GET_FILE_MAX_BYTES=536870912

# How much `modal deploy` / `beam deploy` output /deploy-status retains, in
# bytes. The tail is kept; the head is dropped. 262144 (256 KiB)
DEPLOY_LOG_MAX_BYTES=262144

# ---------------------------------------------------------------------------
# DANGEROUS — arms mass deletion
# ---------------------------------------------------------------------------
# When true, reconciliation DELETES files on the provider that the backend has
# no record of, up to a safety fraction of what exists (see
# calculate_safe_deletion_limit in provider_core/reconciliation.py). Leave this
# false until the provider's contents are exactly what you want kept: it
# deletes, it does not move them to a quarantine, and the deletion runs on a
# timer, not on request.
#   false | true
RECONCILIATION_DELETE_ORPHANS=false

# ---------------------------------------------------------------------------
# Auth shared with the backend
# ---------------------------------------------------------------------------
# These are injected by compose from the root .env and override anything set
# here. PROVIDER_WORKER_TOKEN gates every state-touching route (/inference,
# /download-model, /delete-model, /get-file, /upload-file, /deploy, /info,
# /provider-stats, ...). A worker with an empty token answers 503 on all of
# them, permanently and without retrying — set it.
COMFY_PROVIDER_TOKEN=
# Shared secret for the backend's self-discovery registration.

# See .env.example for the full shared contract, and
# .env.example.provider.engines for the engine knobs the deployed Modal/Beam
# images read.
