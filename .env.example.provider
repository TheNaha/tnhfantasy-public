# ============================================================================
# LEGACY — superseded by .env.example and .env.example.provider.engines
# ============================================================================
# This file is kept for reference only. The canonical backend environment
# reference is `.env.example` (every `COMFY_*` operational knob) and the
# engine-specific reference is `.env.example.provider.engines` (Modal, Beam,
# remote agent, LLM provider, direct ComfyUI credentials). Nothing in the
# backend reads variables from this file, and no compose `env_file:` targets it.
#
# API Tokens (REQUIRED - get these from your accounts)
# ============================================================================
# HF_TOKEN=your_huggingface_token_here
# CIVITAI_TOKEN=your_civitai_token_here

# ============================================================================
# Beam Provider (optional - only if using Beam)
# ============================================================================
# BEAM_API_KEY=your_beam_api_key_here

# ============================================================================
# Modal Provider (REQUIRED for Modal providers)
# ============================================================================
# MODAL_TOKEN_ID=your_modal_token_id_here
# MODAL_TOKEN_SECRET=your_modal_token_secret_here
# MODAL_APP_NAME=comfy-modal-stack
# MODAL_USERNAME=your_modal_username_here

# ============================================================================
# LLM Provider (OpenAI-compatible, e.g. vLLM) (REQUIRED for llm-local)
# ============================================================================
# OPENAI_API_BASE=https://your-vllm-endpoint/v1
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=your-model-name

# ============================================================================
# LLM Provider (Anthropic)
# ============================================================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# LLM Provider (Google Gemini)
# ============================================================================
# GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# Download space guard (all workers)
# ============================================================================
# Headroom kept free on the model volume on top of the bytes a download is about
# to write, so a transfer that exactly fills the volume still leaves room for the
# sidecars and lock files that share the mount. The check runs before any body
# byte is transferred, and an out-of-space failure no longer parks a partial that
# the next attempt would resume into the same full volume.
# Default: 67108864 (64 MiB)
PROVIDER_DOWNLOAD_FREE_SPACE_MARGIN_BYTES=67108864
