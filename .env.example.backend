# Python environment
PYTHONUNBUFFERED=1

# ============================================================================
# Database
# ============================================================================
# Database URL. The stack is Postgres-only: `db` is a pgvector/pg16 service and
# `docker-compose.yml:44` sets this explicitly.
#
# The local-dev default in `backend_v2/config.py` is still
# `sqlite:///./data/db/comfy.db`, which this deployment cannot use — SQLite has
# no pgvector, so every vector column in the schema is unavailable, and a fresh
# local run against the default silently produces a different database from the
# one Docker produces. Set this explicitly for anything that is not the compose
# stack.
# COMFY_DATABASE_URL=postgresql://comfy:comfy@db:5432/comfy
# Local dev against the compose `db` service, from the host:
# COMFY_DATABASE_URL=postgresql://comfy:comfy@localhost:5432/comfy

# ============================================================================
# Data directories
# ============================================================================
# Output and input directories for ComfyUI generations
# OUTPUT_DIR=./data/output
# INPUT_DIR=./data/input

# Preview image cache directory (CivitAI model thumbnails)
# COMFY_PREVIEW_CACHE_DIR=./data/models/cache

# ============================================================================
# Preview cache prefetch
# ============================================================================
COMFY_PREVIEW_PREFETCH_ENABLED=true

# ============================================================================
# Network & API
# ============================================================================
# Docker network name used for provider container detection
# COMFY_DOCKER_NETWORK=tnhcomfy

# CORS Origins. A JSON array, no spaces.
# The real default (backend_v2/config.py, mirrored in .env.example:29 and
# docker-compose.yml:52) is the three below — NOT ["*"], which is what this
# comment used to claim:
#   ["http://localhost:5174","https://comfy.lan.thenaha.my.id","https://100.150.0.4"]
# 5174, not 5173: that is the port the frontend actually runs on.
# COMFY_CORS_ORIGINS=["http://localhost:5174","https://comfy.lan.thenaha.my.id","https://100.150.0.4"]

# Worker backend URL (used by backend to build provider env vars, optional)
# Default: http://backend_v2:8002
# COMFY_WORKER_BACKEND_URL=http://backend_v2:8002

# Backend URL (for providers to communicate back to the backend)
# In Docker compose, this is automatically http://backend_v2:8002
# BACKEND_URL=http://backend_v2:8002

# Uvicorn auto-reload (set to 0 to disable; default is enabled)
# COMFY_UVICORN_RELOAD=1
