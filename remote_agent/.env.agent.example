# Required for network-exposed agent deployments.
#
# This is the COPY source for `.env.agent`, which the compose `env_file:` entry
# loads. It populates the CONTAINER environment, and nothing else — see
# `docker-compose.yml` for why DATA_DIR cannot come from here.
REMOTE_AGENT_TOKEN=replace_with_a_long_random_token

# Optional download credentials
HF_TOKEN=your_huggingface_token
CIVITAI_TOKEN=your_civitai_token

# Optional: per-download ceiling on the agent, seconds. Also the HTTP read
# timeout for every download the agent makes. 1800
# DOWNLOAD_TIMEOUT=1800

# Optional: concurrent asyncio.to_thread calls across every route, sized to the
# default executor's worker count. The 16-way /validate-models fan-out is
# bounded by it; without a bound it can take every thread the single-process
# agent has. 32
# REMOTE_AGENT_THREAD_MAX_CONCURRENT=32

# Optional: concurrent seed downloads during /setup. 3
# REMOTE_AGENT_SEED_MAX_CONCURRENT=3

# Optional: ceiling on one /upload-file body, decoded bytes. 536870912 (512 MiB)
# REMOTE_AGENT_UPLOAD_MAX_BYTES=536870912
