# Required for network-exposed agent deployments.
#
# This is the COPY source for `.env.agent`, which the compose `env_file:` entry
# loads. It populates the CONTAINER environment, and nothing else — see
# `docker-compose.yml` for why DATA_DIR cannot come from here.
REMOTE_AGENT_TOKEN=replace_with_a_long_random_token

# Optional download credentials
HF_TOKEN=your_huggingface_token
CIVITAI_TOKEN=your_civitai_token

# Optional: per-download ceiling on the agent, seconds. Also the HTTP read
# timeout for every download the agent makes. 1800
# DOWNLOAD_TIMEOUT=1800

# Optional: concurrent asyncio.to_thread calls across every route, sized to the
# default executor's worker count. The 16-way /validate-models fan-out is
# bounded by it; without a bound it can take every thread the single-process
# agent has. 32
# REMOTE_AGENT_THREAD_MAX_CONCURRENT=32

# Optional: concurrent seed downloads during /setup. 3
# REMOTE_AGENT_SEED_MAX_CONCURRENT=3

# Optional: ceiling on one /upload-file body, decoded bytes. 536870912 (512 MiB)
# REMOTE_AGENT_UPLOAD_MAX_BYTES=536870912

# --- Storage root, per worker mode -----------------------------------------
# Where this container's storage root is. ONE of these wins, chosen by
# WORKER_MODE, and each falls back to DATA_DIR when unset:
#
#   WORKER_MODE=model -> DATA_DIR        (default)
#   WORKER_MODE=llm   -> LLM_DATA_DIR    (falls back to DATA_DIR)
#   WORKER_MODE=tts   -> TTS_DATA_DIR    (falls back to DATA_DIR)
#
# They exist because the three modes want different trees, and the difference is
# not hypothetical: an image worker points at its ComfyUI repo root, an LLM
# worker wants a plain weights directory with no ComfyUI structure in it at all,
# and a TTS worker is usually back on a ComfyUI rig because it shares one. One
# variable per mode means the mapping is explicit at deployment rather than
# being a shared root someone has to reason about.
#
# The root is the container's storage ROOT, so `models/`, `output/`, `input/`
# and `audio/` live under it. Point `LLM_DATA_DIR=/models` at an LLM worker and
# its models tree is `/models/models`, leaving the ComfyUI root alone.
#
# DATA_DIR=/home/user/ComfyUI
# LLM_DATA_DIR=/home/user/llm-weights
# TTS_DATA_DIR=/home/user/ComfyUI
#
# Under compose these resolve the bind mount in `docker-compose.yml` the same way
# DATA_DIR does — pass them to COMPOSE, not to this file, because `env_file:`
# populates the container and the mount is already resolved by then.

# --- Worker mode -----------------------------------------------------------
# The same image is deployed as a MODEL agent (default), an LLM worker, or a
# TTS worker. The provider matrix's "remote" transport is one container
# deployed anywhere with Docker, so one image that can be three things is one
# image to build and run on a GPU box rather than three.
#
#   WORKER_MODE=model   model-file ownership: /download-model, /list-models,
#                       /validate-models, /get-file. Default, and what every
#                       existing deployment already runs.
#   WORKER_MODE=llm     OpenAI-compatible chat proxy: /v1/chat/completions.
#   WORKER_MODE=tts     speech synthesis: /synthesize.
#
# Only the matching pair of routes answers; the others stay 404. Change it and
# recreate the container.
# WORKER_MODE=model

# --- WORKER_MODE=llm ------------------------------------------------------
# OPTIONAL, and now the OPT-OUT rather than the only way.
#
# Leave it UNSET (the default) and this worker serves its OWN weights: it launches
# one llama-server per distinct model in models.json, on loopback ports, and routes
# by the model id in the payload. That is what makes a `remote_llm` provider the
# same thing as `modal_llm` — Modal's app (backend_v2/modal_llm/app.py) launches
# llama.cpp from the same file — so the tree this worker manages is the tree that
# answers, and there is nothing to reconcile.
#
# Set it to front a llama.cpp or vLLM you ALREADY run, on this host or another
# container on the compose network. The worker is then an authenticated proxy
# instead of a model server.
# LLM_UPSTREAM_BASE=http://127.0.0.1:8080/v1
#
# With no LLM_UPSTREAM_BASE and no weights, this worker starts healthy and
# /info reports each role `not_downloaded` with the reason — same shape as Modal's
# health, so polling either shows an actionable state rather than a crash-loop.
# Fetch weights with:
#     curl -X POST -H "Authorization: Bearer $REMOTE_AGENT_TOKEN" \
#          -H "Content-Type: application/json" \
#          -d '{"model_id": "<id from models.json>"}' \
#          http://localhost:8001/download-model
# The repo and destination both come from models.json, so a typo cannot put a
# file where llama-server will not find it. Then recreate the container so the
# new model loads.

# --- WORKER_MODE=tts ------------------------------------------------------
# Any shell command that turns text into a wav. The container ships no model by
# default; point this at Qwen3-TTS or a local server. It receives the text
# on stdin-free environment variables: TTS_TEXT, TTS_VOICE, TTS_OUTPUT,
# TTS_FORMAT, TTS_SPEED, TTS_SAMPLE_RATE.
# TTS_COMMAND=python3 /opt/tts/synthesize.py

# Wall-clock ceiling for one TTS_COMMAND run, seconds. 600
# TTS_COMMAND_TIMEOUT=600
