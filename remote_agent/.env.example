# Remote Agent local environment (Linux/macOS and the frozen Windows exe).
# Copy to `.env` and edit, then run `./agentctl.sh start` (Linux) or
# `agentctl.bat` (Windows). These values are read by server.py at startup.

# Storage ROOT that holds models/, output/, input/. Mount your ComfyUI repo
# root here (NOT its models/ subdir). The agent reads/writes model files at
# paths like "models/checkpoints/x.safetensors".
# Examples:
#   Linux:   /opt/comfyui/ComfyUI        (ComfyUI repo root)
#   Windows: C:\ComfyUI                  (ComfyUI repo root)
DATA_DIR=/opt/comfyui/ComfyUI

# Listen address (the Backend worker connects here via REMOTE_AGENT_URL).
#
# Leave this OUT, or set it to a loopback address, unless the agent is
# token-protected. With REMOTE_AGENT_ALLOW_INSECURE set and HOST non-loopback,
# server.py prints a warning naming the four unauthenticated routes
# (/delete-model, /delete-file, /upload-file, /download-model) and then binds
# 127.0.0.1 anyway — the flag is for local dev, and it will not silently hand an
# unauthenticated *writer* to every interface.
#
# The example shows 0.0.0.0 because the documented use of this file is a rig where
# the token IS set. If you set REMOTE_AGENT_TOKEN to empty, change this to 127.0.0.1.
HOST=0.0.0.0
PORT=8001

# Require callers (the remote-comfy provider worker) to present this token.
# Keep empty to disable authentication (NOT recommended in production).
REMOTE_AGENT_TOKEN=your-secret-token-here

# Model download tokens (used by provider_core.downloads for HF + CivitAI).
HF_TOKEN=hf_xxxxxxxxxxxxxxxx
CIVITAI_TOKEN=your-civitai-token

# Download timeout in seconds. Also the HTTP read timeout for every download the
# agent makes — without it `requests.get` blocks forever on a peer that accepts
# the connection and then goes quiet (default 1800).
DOWNLOAD_TIMEOUT=1800

# Concurrent asyncio.to_thread calls across every route. `asyncio.to_thread`
# uses the default executor, whose worker count is bounded but NOT by this number:
# 16 unbounded /validate-models scans plus a /get-file walk plus a download could
# occupy every thread the single-process agent has and stop it answering at all
# (default 32).
REMOTE_AGENT_THREAD_MAX_CONCURRENT=32

# Concurrent seed downloads during the agent's own /setup (default 3).
REMOTE_AGENT_SEED_MAX_CONCURRENT=3

# Ceiling on one /upload-file body, in decoded bytes. The base64 payload is a JSON
# *string* field, so the whole body is parsed into memory before the handler runs;
# the declared Content-Length is rejected first and the encoded length second
# (default 536870912, 512 MiB).
REMOTE_AGENT_UPLOAD_MAX_BYTES=536870912

# --- Worker mode -----------------------------------------------------------
# `model` (default) serves the model-file routes (/download-model,
# /list-models, /validate-models, /get-file). `llm` serves
# /v1/chat/completions. `tts` serves /synthesize. One image, three roles, so
# one Dockerfile to build on a GPU box rather than three (default: model).
WORKER_MODE=model

# --- WORKER_MODE=llm ------------------------------------------------------
# The OpenAI-compatible server this worker fronts: llama.cpp or vLLM, on the
# same host or another container. The worker proxies plus checks the service
# token, which is how the backend keeps one auth scheme while the model server
# underneath stays plain.
LLM_UPSTREAM_BASE=http://127.0.0.1:8080/v1

# Per-request ceiling for the upstream chat call, seconds (default 600).
LLM_UPSTREAM_TIMEOUT=600

# --- WORKER_MODE=tts ------------------------------------------------------
# Any shell command that turns text into a wav. The container ships no model by
# default; point this at Kokoro, Coqui, or a local server. It receives the
# request on TTS_TEXT, TTS_VOICE, TTS_OUTPUT, TTS_FORMAT, TTS_SPEED and
# TTS_SAMPLE_RATE. Empty means no synthesis is configured, and /synthesize
# answers 503 rather than crashing.
# TTS_COMMAND=python3 /opt/tts/synthesize.py

# Wall-clock ceiling for one TTS_COMMAND run, seconds (default 600).
TTS_COMMAND_TIMEOUT=600

# Sub-directory under DATA_DIR that synthesised clips are written to, and read
# back from through the existing /get-file route (default: audio).
TTS_AUDIO_DIR=audio
