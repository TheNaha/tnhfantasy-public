# Remote Agent local environment (Linux/macOS and the frozen Windows exe).
# Copy to `.env` and edit, then run `./agentctl.sh start` (Linux) or
# `agentctl.bat` (Windows). These values are read by server.py at startup.

# Storage ROOT that holds models/, output/, input/. Mount your ComfyUI repo
# root here (NOT its models/ subdir). The agent reads/writes model files at
# paths like "models/checkpoints/x.safetensors".
# Examples:
#   Linux:   /opt/comfyui/ComfyUI        (ComfyUI repo root)
#   Windows: C:\ComfyUI                  (ComfyUI repo root)
DATA_DIR=/opt/comfyui/ComfyUI
# Per-mode storage root overrides. One wins, chosen by WORKER_MODE:
#   WORKER_MODE=model -> DATA_DIR (default)
#   WORKER_MODE=llm   -> LLM_DATA_DIR
#   WORKER_MODE=tts   -> TTS_DATA_DIR
# Each falls back to DATA_DIR. Use LLM_DATA_DIR to point an LLM worker at a
# plain weights directory instead of a ComfyUI repo, and TTS_DATA_DIR to put a
# TTS worker back on a ComfyUI rig.
# LLM_DATA_DIR=/opt/llm-weights
# TTS_DATA_DIR=/opt/comfyui/ComfyUI

# Listen address (the Backend worker connects here via REMOTE_AGENT_URL).
#
# Leave this OUT, or set it to a loopback address, unless the agent is
# token-protected. With REMOTE_AGENT_ALLOW_INSECURE set and HOST non-loopback,
# server.py prints a warning naming the four unauthenticated routes
# (/delete-model, /delete-file, /upload-file, /download-model) and then binds
# 127.0.0.1 anyway — the flag is for local dev, and it will not silently hand an
# unauthenticated *writer* to every interface.
#
# The example shows 0.0.0.0 because the documented use of this file is a rig where
# the token IS set. If you set REMOTE_AGENT_TOKEN to empty, change this to 127.0.0.1.
HOST=0.0.0.0
PORT=8001

# Require callers (the remote-comfy provider worker) to present this token.
# Keep empty to disable authentication (NOT recommended in production).
REMOTE_AGENT_TOKEN=your-secret-token-here

# Model download tokens (used by provider_core.downloads for HF + CivitAI).
HF_TOKEN=hf_xxxxxxxxxxxxxxxx
CIVITAI_TOKEN=your-civitai-token

# Optional provider ID for backend synchronization & reconciliation
PROVIDER_ID=colab_worker

# Download timeout in seconds. Also the HTTP read timeout for every download the
# agent makes — without it `requests.get` blocks forever on a peer that accepts
# the connection and then goes quiet (default 1800).
DOWNLOAD_TIMEOUT=1800

# Concurrent asyncio.to_thread calls across every route. `asyncio.to_thread`
# uses the default executor, whose worker count is bounded but NOT by this number:
# 16 unbounded /validate-models scans plus a /get-file walk plus a download could
# occupy every thread the single-process agent has and stop it answering at all
# (default 32).
REMOTE_AGENT_THREAD_MAX_CONCURRENT=32

# Concurrent seed downloads during the agent's own /setup (default 3).
REMOTE_AGENT_SEED_MAX_CONCURRENT=3

# Ceiling on one /upload-file body, in decoded bytes. The base64 payload is a JSON
# *string* field, so the whole body is parsed into memory before the handler runs;
# the declared Content-Length is rejected first and the encoded length second
# (default 536870912, 512 MiB).
REMOTE_AGENT_UPLOAD_MAX_BYTES=536870912

# --- Worker mode -----------------------------------------------------------
# `model` (default) serves the model-file routes (/download-model,
# /list-models, /validate-models, /get-file). `llm` serves
# /v1/chat/completions. `tts` serves /synthesize. One image, three roles, so
# one Dockerfile to build on a GPU box rather than three (default: model).
WORKER_MODE=model

# --- WORKER_MODE=llm ------------------------------------------------------
# The OpenAI-compatible server this worker fronts. COMMENTED OUT BY DEFAULT,
# which is the parity setting: with no upstream this worker serves its OWN
# weights, launching one llama-server per distinct model from models.json on
# loopback ports and routing by the model id in the payload. That is what
# Modal's app does too (deployables/modal/llm/app.py), from the same file, so a
# remote_llm provider is the same thing as `modal_llm` rather than a lookalike.
#
# Set it to front a llama.cpp or vLLM you already run elsewhere. The worker then
# proxies plus checks the service token, instead of being a model server.
# LLM_UPSTREAM_BASE=http://127.0.0.1:8080/v1
#
# Fetch weights for a model id from models.json with POST /download-model
# {"model_id": "<id>"}; repo and destination both come from models.json.
# LLM_REGISTRY_PATH=./models.json

# Per-request ceiling for the upstream chat call, seconds (default 600).
LLM_UPSTREAM_TIMEOUT=600

# --- WORKER_MODE=tts ------------------------------------------------------
# Any shell command that turns text into a wav. The container ships no model by
# default; point this at Qwen3-TTS or a local server. It receives the
# request on TTS_TEXT, TTS_VOICE, TTS_OUTPUT, TTS_FORMAT, TTS_SPEED and
# TTS_SAMPLE_RATE. Empty means no synthesis is configured, and /synthesize
# answers 503 rather than crashing.
# TTS_COMMAND=python3 /opt/tts/synthesize.py

# Wall-clock ceiling for one TTS_COMMAND run, seconds (default 600).
TTS_COMMAND_TIMEOUT=600

# Sub-directory under DATA_DIR that synthesised clips are written to, and read
# back from through the existing /get-file route (default: audio).
TTS_AUDIO_DIR=audio

# --- GPU allocation ---------------------------------------------------------
# Which CUDA device each workload runs on. The agent runs the image engine
# (ComfyUI) and the LLM engine (llama.cpp) on the same box, so on a multi-GPU
# rig they have to be told to use different ones — otherwise both land on
# device 0 and the second one OOMs against the first.
#
# The default is device 0 for images, and device 1 for the LLM when the box
# has two or more GPUs, device 0 otherwise. Laya (the System 1 director) runs
# alongside the LLM and defaults to the LLM's device; give it its own only if
# you have a third GPU for it.
# COMFY_GPU_DEVICE=0
# LLM_GPU_DEVICE=1
# LAYA_GPU_DEVICE=1

# Where the agent reaches ComfyUI, and where it reaches its own LLM server.
# The defaults are the loopback addresses the agent starts on itself; set them
# only when one of those servers runs somewhere else.
# COMFY_URL=http://127.0.0.1:8188
# LLM_URL=http://127.0.0.1:8003
# LLM_PORT=8003

# How long an idle LLM server is kept warm before it is unloaded, seconds
# (default 600). Lower it on a shared box to free the VRAM sooner; raise it
# if the rig reloads the model between turns.
# LLM_IDLE_TIMEOUT_SECONDS=600

# --- LLM model selection ----------------------------------------------------
# Which model the agent serves for each of the two LLM roles, when the
# request does not name one. `ACTIVE_*` wins over `DEFAULT_*`; both fall back
# to the built-in defaults when unset.
#
# These are ids from `models.json`, not paths.
# ACTIVE_RP_MODEL=artemis_31b_q4
# ACTIVE_UTIL_MODEL=gemma3_12b_heretic_util
# DEFAULT_RP_MODEL=
# DEFAULT_UTIL_MODEL=

# The model id the Laya director runs under (default laya_multilingual).
# LAYA_MODEL_ID=laya_multilingual

# KV-cache quantisation for the managed llama-server (default q8_0) and the
# context window it is started with, in tokens (default 8192). A larger
# context costs VRAM; a quantised cache costs a little quality and saves a
# lot of VRAM.
# CACHE_KV_TYPE=q8_0
# LLAMA_CTX_SIZE=8192

# --- Weight lookup ----------------------------------------------------------
# Extra directories to search for LLM weights, in order, before the built-in
# ones. `PERSISTENT_STORAGE_PATH` is the first: point it at a mounted
# volume that survives a container restart. `GDRIVE_LLM_PATH` is for a
# Google-Drive-backed copy, which is what the Colab worker uses.
# PERSISTENT_STORAGE_PATH=/mnt/data/tnhcomfy/llm_models
# GDRIVE_LLM_PATH=/content/drive/MyDrive/tnhcomfy/llm_models

# --- RAM cache --------------------------------------------------------------
# Where model weights are staged in RAM before being served (default
# /dev/shm/tnh_ram_cache), and the ceiling on that cache in GB. A budget
# that is not set means "as much as the weights need".
# RAM_CACHE_DIR=/dev/shm/tnh_ram_cache
# RAM_CACHE_BUDGET_GB=24

# Whether weights are staged in RAM at all. "auto" (the default) stages them
# only on a host with at least 20 GB of RAM, because a smaller one would OOM.
# Set it to 0 to stream from the volume instead, which is slower but safe on
# a small box.
# CACHE_IN_RAM=auto

# Extra directories for the managed llama-server to find CUDA and its own
# shared libraries. The agent builds this itself; set it only to add to it.
# LD_LIBRARY_PATH=
