# TNHComfy Backend configuration
# The backend will connect to your remote-comfy container to orchestrate downloads and inference.
COMFYUI_URL=http://your-gpu-rig-ip:8188
REMOTE_AGENT_URL=http://your-gpu-rig-ip:8001
# (Optional) Token for the remote agent if you set REMOTE_AGENT_TOKEN on the agent
REMOTE_AGENT_TOKEN=

# Optional: CivitAI and HuggingFace tokens for downloading models directly to your disk
CIVITAI_TOKEN=your_civitai_token
HF_TOKEN=your_huggingface_token
