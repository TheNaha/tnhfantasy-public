# Python environment
PYTHONUNBUFFERED=1

# SQLite Database Location
COMFY_DATABASE_URL=sqlite:///./data/comfy.db

# API Tokens
HF_TOKEN=your_huggingface_token_here
CIVITAI_TOKEN=your_civitai_token_here

# Beam Provider Configuration
BEAM_API_KEY=your_beam_api_key_here
BEAM_GPU_URL=your_beam_gpu_url_here
BEAM_STORAGE_URL=your_beam_storage_url_here
BEAM_DOWNLOAD_URL=your_beam_download_url_here
# Modal Provider Configuration
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Backend URL (For providers to communicate back to the backend)
# In Docker compose, this is usually http://backend_v2:8002
BACKEND_URL=http://backend_v2:8002
