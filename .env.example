# ============================================================================
# TNHComfy — Environment Configuration
# ============================================================================
# This is the single canonical reference for every environment variable the
# stack reads. It serves two roles:
#
#   1. Compose template: `docker compose up` reads this (via `env_file: - .env`
#      in docker-compose.yml) and interpolates ${VAR} into service `environment:`
#      blocks. Lines marked "compose sets" below are consumed by Compose itself;
#      you should NOT set them here unless you know what you are doing.
#
#   2. Backend documentation: uncommented lines below are the active defaults
#      for the backend. Commented lines are knobs you *can* set, with notes on
#      what each does and what breaks when it is unset.
#
# Defaults are the values in the source (`backend_v2/config.py` and the
# in-process engine modules), not guesses. `tests/test_env_contracts.py` fails
# if code reads a variable that appears in no `.env.example*` file, so this list
# cannot silently fall behind the code.
#
# Copy this file to `.env` and adjust for your host. `.env` is gitignored.
# ============================================================================

PYTHONUNBUFFERED=1

# ============================================================================
# Database (PostgreSQL — pgvector / pg16)
# ============================================================================
# Compose assembles the DSN from these discrete values
# (backend_v2/infrastructure/database.py), NOT from COMFY_DATABASE_URL:
# interpolating a password in compose produced an unparseable DSN whenever
# POSTGRES_PASSWORD contained @ : / # — the backend then failed its healthcheck
# and everything behind it never started. Leave COMFY_DATABASE_URL out of `.env`
# for compose runs; set it only for a host-only run where POSTGRES_HOST is unset.
#
# The local-dev default in config.py is still
# `sqlite:///./data/db/comfy.db`, which this stack cannot use — SQLite has no
# pgvector, so every vector column in the schema is unavailable. Set
# COMFY_DATABASE_URL explicitly for non-compose runs.
#   postgresql://comfy:comfy@db:5432/comfy          (in-container)
#   postgresql://comfy:comfy@localhost:5432/comfy    (host, dev override publishes db on 5432)
#   sqlite:///./data/db/comfy.db                     (purely local, no Postgres)
POSTGRES_USER=comfy
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=comfy

# ============================================================================
# In-process compute engines (Modal, Beam, Direct ComfyUI, LLM, TTS)
# ============================================================================
# In-process engines run directly inside backend_v2 (`services/engines/`). This
# is the DEFAULT and the ONLY runtime: the provider CONTAINERS they replaced were
# removed on 2026-10-09, together with the `--profile providers` compose profile
# and the `COMFY_USE_IN_PROCESS_ENGINES` flag that used to select between them.
#
# Per-engine credentials and their env fallbacks (MODAL_*, BEAM_*, OPENAI_*,
# COMFYUI_*, REMOTE_AGENT_*) live in `.env.example.provider.engines`.

# How long a built-in engine stays cached (seconds). A credential rotation
# heals at worst one TTL late; provider PATCH/DELETE invalidates immediately.
# COMFY_ENGINE_CACHE_TTL_SECONDS=1800

# ============================================================================
# Compute engine credentials
# ============================================================================
# These live in per-provider `.env.<provider_id>` files (see
# COMFY_PROVIDER_ENV_PATH below), not in the top-level `.env`. Copy the relevant
# template from `.env.example.provider.engines` and set the values.

# Common tokens used across providers:
HF_TOKEN=
CIVITAI_TOKEN=

# --- Provider trust boundary (infrastructure/http_client.py, api/routes/discovery.py) ---
# The ONE shared secret for the backend <-> provider relationship.
#
# It authenticates both directions, which is what it always did — there used to
# be two variables (PROVIDER_WORKER_TOKEN for backend -> container,
# COMFY_DISCOVERY_TOKEN for container -> backend), and having two was how this
# broke: with the discovery one empty and the management one set, every provider
# failed to register, the log filled with `discovery_token_not_configured`,
# and nothing else looked wrong.
#
#   - backend  -> container : `X-Provider-Token` on inference, model
#                             download/delete, file get/upload, /deploy
#   - container -> backend  : `X-Provider-Token` on self-registration
#
# THIS MUST NOT BE LEFT EMPTY. Both ends fail CLOSED without it: a container
# with an empty token answers 503 on every protected route, and the backend
# refuses unauthenticated provider registration (503,
# `discovery_token_not_configured`).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Compose interpolates it into every provider's environment block as well as
# the backend's, because `env_file:` cannot supply a variable the two ends must
# agree on. An empty value is a permanent 503 on every provider route.
COMFY_PROVIDER_TOKEN=

# Host path to the project root, mounted at /comfyui in the backend container
# so in-process engines can discover `.env.<provider_id>` credential files.
COMFY_PROVIDER_ENV_PATH=/comfyui

# --- Provider host allowlists (NOT "add the provider" switches) ---
# Both are RESTRICTIONS, not gates: unset means "no restriction".
#
# Hosts the backend must NOT send the shared token to. Everything else is
# recognised from the provider TABLE or the `tnhcomfy-` container-name prefix.
# Only add a genuinely external host that must not receive the token.
COMFY_WORKER_HOSTS=
#
# If set, a provider may only register with a hostname on this list; anything
# else is refused with 422. Unset means any host may register.
# COMFY_DISCOVERY_ALLOWED_HOSTS=

# --- Provider lifecycle (services/load_balancer.py) ---
# Warm a COLD provider in the background when it wins selection, instead of
# letting the first job pay the cold start. Off by default: a cold provider that
# loses the next selection still paid nothing for the warm-up.
COMFY_PROVIDER_AUTOSTART_ENABLED=0
# Background provider health probes. Default is ON; set 0 only to silence them
# (some tests do). Turning it off means the load balancer keeps dispatching to a
# provider that is not answering until a job fails.
COMFY_LB_HEALTH_CHECKS_ENABLED=1

# ============================================================================
# Network & API
# ============================================================================
# Every origin the stack is reached on. The port is not optional:
# `https://100.150.0.4` is Traefik on 443 and `http://100.150.0.4:5174` is the
# frontend directly — different scheme, different port, so the first does not
# match the second. Omitting the second makes socket.io return 400 and the
# UI show a permanent "Disconnected from server" toast while HTTP looks fine.
# 5174, not 5173: that is the port the frontend actually runs on.
COMFY_CORS_ORIGINS=["http://localhost:5174","http://localhost:8002","http://127.0.0.1:5174","https://comfy.lan.thenaha.my.id","https://100.150.0.4","http://100.150.0.4:5174"]

# Address the frontend is published on. Unset = 127.0.0.1, which is the safe
# default and costs nothing: Traefik reaches the frontend on the external
# `proxy` docker network, so a host port is only for reaching it directly.
#
# This matters more than it looks. The frontend proxies `/api` to the backend
# (nginx.conf in prod, vite.config.js in dev), so publishing the frontend
# publishes the entire unauthenticated API, which is why the backend itself has
# no host port at all. Name ONE address to serve the site from another machine:
#   COMFY_FRONTEND_BIND=100.150.0.4      # a VPN/Tailscale address
#   COMFY_FRONTEND_BIND=192.168.1.28     # a LAN address, if you accept the LAN
# Do not set 0.0.0.0. It serves the API on every interface including the plain
# home LAN, and scripts/preflight.sh fails on it for that reason.
COMFY_FRONTEND_BIND=

# Address the BACKEND is published on, for the same reason as above: the
# backend has no host port of its own in the default compose file, and
# docker-compose.yml adds this one bound to the private NetBird mesh
# interface (never the public internet). It is published on loopback too, so
# the API is always reachable locally.
#
# The compose default is 100.150.0.4 — a NetBird address, which is right for
# the mesh this stack is built around and wrong for anything else. Set it to
# a LAN address if you are reaching the API from another machine on the LAN
# and accept that the API is unauthenticated on that network.
# COMFY_BACKEND_BIND=192.168.1.28
COMFY_BACKEND_BIND=

# Worker backend URL (used by backend to build provider env vars, optional)
# COMFY_WORKER_BACKEND_URL=http://backend_v2:8002

# Backend URL (for providers to communicate back to the backend, optional)
# BACKEND_URL=http://backend_v2:8002

# Uvicorn auto-reload (set to 0 to disable; default is enabled)
# COMFY_UVICORN_RELOAD=1

# ============================================================================
# Data directories
# ============================================================================
# Output and input directories for ComfyUI generations.
# In Docker the compose file points these at /data so generated files survive a
# container recreate.
# The code prefers COMFY_OUTPUT_DIR / COMFY_INPUT_DIR, falling back to the
# unprefixed names (OUTPUT_DIR / INPUT_DIR) used by the worker scripts.
# COMFY_INPUT_DIR=/data/input
# COMFY_OUTPUT_DIR=/data/output
# INPUT_DIR=/data/input
# OUTPUT_DIR=/data/output

# Default user partition for multi-tenancy. The backend writes generated images
# under /{user_id}/ for scoping. A single-user deployment uses the default.
# COMFY_DEFAULT_USER_ID=default_user

# Font used for comic/webtoon PDF text rendering. Point at any installed TTF if
# DejaVu is absent from the container.
# COMFY_COMIC_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Embedding model for the World Vault vector search (sentences-transformers ID).
# Changing the model requires re-embedding existing documents.
# COMFY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Preview image cache directory (CivitAI model thumbnails).
# The code reads CACHE_DIR for the file server and COMFY_PREVIEW_CACHE_DIR for
# the model-preview service.
# CACHE_DIR=/data/cache
# COMFY_PREVIEW_CACHE_DIR=/data/cache

# ============================================================================
# Preview cache prefetch
# ============================================================================
# The source default is False (backend_v2/services/model_preview_service.py:38),
# but the deployed stack sets this to true regardless via the compose
# environment block, so this file's value is only consulted for a host-only run
# that does not go through compose. To match the deployed stack, leave it true.
COMFY_PREVIEW_PREFETCH_ENABLED=true

# ============================================================================
# Job lifecycle
# ============================================================================
# These take precedence over the `jobs` block in the Settings UI, which is why
# they are listed here rather than under the tunables below.
#
# Set COMFY_JOB_TIMEOUT below COMFYUI_TIMEOUT_SECONDS (the image worker's own
# limit) and the backend abandons a workflow the worker is still running.
COMFY_JOB_TIMEOUT=3600
COMFY_JOB_MAX_RETRIES=3
COMFY_JOB_RETRY_BASE_DELAY=1.0
COMFY_JOB_RETRY_MAX_DELAY=60.0

# ============================================================================
# Tunables read by the backend
# ============================================================================
# Every variable below is read by live code. They were previously read and
# documented nowhere, which meant an operator could not discover them and could
# not set them; the upload and export limits in particular are the difference
# between a large upload working and returning 413.

# --- Database connection pool (infrastructure/database.py) ---
# Per-process. With N backend workers the total is N x (POOL_SIZE + MAX_OVERFLOW).
COMFY_DB_POOL_SIZE=30
COMFY_DB_MAX_OVERFLOW=30
# Seconds a request may wait for a pooled connection before failing.
COMFY_DB_POOL_TIMEOUT=30
# Seconds after which a pooled connection is recycled.
COMFY_DB_POOL_RECYCLE=1800
# Source SQLite for `scripts/migrate_sqlite_to_pg.py` only. Leave unset for normal
# operation — the running app uses COMFY_DATABASE_URL.
# COMFY_DATABASE_URL=postgresql://comfy:comfy@db:5432/comfy
# COMFY_SQLITE_DATABASE_URL=sqlite:///./data/comfy.db

# --- Logging and HTTP (api/main.py, config.py) ---
COMFY_LOG_LEVEL=INFO
COMFY_LOG_FORMAT=compact
# Responses below this many bytes are not gzipped.
COMFY_GZIP_MINIMUM_SIZE=1000
# Size of the websocket event-broadcast queue. Events are dropped rather than
# blocking the publisher when it is full.
COMFY_WS_BROADCAST_QUEUE_SIZE=500
# How long an identical in-flight request is coalesced, in seconds.
COMFY_REQUEST_DEDUP_TTL_SECONDS=30

# --- Uploads, exports and batch limits (core/upload_validation.py) ---
COMFY_MAX_UPLOAD_SIZE_MB=500
# Source/mask images handed to ComfyUI, which resizes them anyway.
COMFY_MAX_INPUT_SIZE_MB=50
# Avatars and location images, rendered inline in the UI.
COMFY_MAX_AVATAR_SIZE_MB=20
# Character card PNGs and chat/JSON imports.
COMFY_MAX_CARD_SIZE_MB=25
# Batch download archive budget.
COMFY_MAX_EXPORT_FILES=500
COMFY_MAX_EXPORT_FILE_MB=250
COMFY_MAX_EXPORT_TOTAL_MB=1024
# Guard against decompression bombs in uploaded images.
COMFY_MAX_IMAGE_DIMENSION=16384
COMFY_MAX_IMAGE_PIXELS=64000000
# Per-request cap on list-style endpoints.
COMFY_MAX_BATCH_ITEMS=1000
# Seconds a single stalled upload read may block before it is aborted.
COMFY_UPLOAD_TIMEOUT_SECONDS=300

# --- Model preview cache (services/model_preview_service.py) ---
# Metadata fetch timeout when a model has no cached metadata.
COMFY_PREVIEW_METADATA_TIMEOUT_SECONDS=10.0
# Image fetch timeout for a preview.
COMFY_PREVIEW_IMAGE_TIMEOUT_SECONDS=30.0
# How long a failed preview is remembered as failed, in seconds.
COMFY_PREVIEW_FAILURE_TTL_SECONDS=600
# How long a known-missing preview is remembered as missing, in seconds.
COMFY_PREVIEW_NOT_FOUND_TTL_SECONDS=21600
# Background prefetch cadence and size.
COMFY_PREVIEW_PREFETCH_INTERVAL_SECONDS=300
COMFY_PREVIEW_PREFETCH_BATCH_SIZE=10
COMFY_PREVIEW_PREFETCH_MAX_CANDIDATES=50
COMFY_PREVIEW_PREFETCH_STALE_AFTER_SECONDS=86400
# Randomised per-item delay, so a prefetch burst does not look like one.
COMFY_PREVIEW_PREFETCH_JITTER_SECONDS=60.0
COMFY_PREVIEW_PREFETCH_ITEM_DELAY_SECONDS=2.0
# Where cached previews live. Defaults to backend_v2/cache/previews.
# COMFY_PREVIEW_CACHE_DIR=/data/cache

# --- Load balancer and provider health (services/load_balancer.py) ---
# Consecutive failures before a provider is skipped.
COMFY_FAILURE_STREAK_THRESHOLD=3
# Same, for the always-on LLM endpoints, which have no cold-start path.
COMFY_LLM_FAILURE_STREAK_THRESHOLD=3
# Bound on the in-process engine health probe in `_check_provider_health`, in
# seconds. The 15s health cache means this only applies to the first caller to
# miss.
COMFY_LB_ENGINE_HEALTH_TIMEOUT_SECONDS=5.0
# Availability cache bounds for routing decisions.
COMFY_MODEL_AVAILABILITY_CACHE_TTL_SECONDS=3.0
COMFY_MODEL_AVAILABILITY_CACHE_MAX_ENTRIES=256

# --- Direct ComfyUI providers (services/engines/engine_factory.py, direct_comfy_engine.py) ---
# Root URL of a ComfyUI instance with no agent sidecar, used as the fallback when
# the provider row carries none. Defaults to http://localhost:8188.
# COMFYUI_URL=http://localhost:8188
# API key for a rig behind an authenticating reverse proxy. Leave empty for a
# plain local instance.
# COMFYUI_API_KEY=
# Seconds allowed for each of the two concurrent upstream /health probes. The
# dispatcher's health budget is ~2s, so two sequential 1.5s probes would read as
# "no answer" on a fully dead rig. 1.5
# COMFYUI_HEALTH_PROBE_TIMEOUT=1.5

# --- Remote agent (remote_agent/server.py) ---
# Per-download ceiling on the remote agent, in seconds. Also the HTTP read
# timeout for every download the agent makes — without it `requests.get` blocks
# forever on a peer that accepts the connection and then goes quiet. 1800
# DOWNLOAD_TIMEOUT=1800
# Deadline on one `asyncio.to_thread` call the agent runs, in seconds. Derived
# from DOWNLOAD_TIMEOUT + 600 when unset, because a download is the longest
# thing the agent legitimately does. `0` disables the deadline.
# REMOTE_AGENT_THREAD_TIMEOUT_SECONDS=2400

# --- Modal TTS engine (services/engines/modal_tts_engine.py) ---
# Modal class that owns the audio volume, resolved after the provider row's own
# `storage_class`. Override only if your app names it differently.
# MODAL_TTS_STORAGE_CLASS=TTSFileStorage

# --- Roleplay and LLM job behaviour ---
# Per-tool timeout for an agentic tool call, in seconds.
COMFY_TOOL_TIMEOUT=360
# Idle simulation. The Settings toggle `ai.idleSimEnabled` is the user-facing
# control; this is the registration switch checked at startup.
# COMFY_IDLE_SIM_ENABLED=1
# Overrides ai.idleSimIntervalSeconds when set.
# COMFY_IDLE_SIM_INTERVAL_SECONDS=600

# --- Asset reconciliation (services/asset_reconciler.py) ---
# Set to 1 to force a full rescan instead of the per-user fast path.
# COMFY_ASSET_MIGRATION_FORCE=0

# --- Paths (config.py) ---
# These override the packaged paths. In Docker the compose file points them at
# /data so generated files survive a container recreate.
# COMFY_CONFIG_PATH=/data/config.json
# CACHE_DIR=/data/cache

# --- Worker processes ---
# The backend runs ONE uvicorn process. Production ships one on a 2-CPU limit,
# and the throughput ceiling is single-process GIL plus the middleware chain
# (measured ~300 req/s).
#
# Raising this REFUSES TO START, and that is deliberate rather than a missing
# feature. Job dispatch is already safe under multiple processes — the claim
# query is `FOR UPDATE SKIP LOCKED` and requires `jobs.enqueued_at`, so workers
# claim disjoint rows — and migrations and the scheduled jobs are now
# advisory-locked. What is NOT safe is the websocket broadcast: `ws_manager`
# is per-process, so a client connected to one worker would not receive an
# event emitted by another, and job progress would look frozen for roughly the
# fraction of users on the other worker. That needs a socket.io message-bus
# adapter (Redis or Postgres pub/sub) first.
#
# Silently accepting it would pass every test and intermittently drop every
# realtime update in production — far harder to diagnose than a refusal at boot.
# COMFY_UVICORN_WORKERS=1
# The conventional alternative name for the same setting, also checked.
# WEB_CONCURRENCY=1

# --- Model reconciliation & deployment ---
# Number of concurrent directory listings during model reconciliation (maintenance.py).
COMFY_RECONCILIATION_LIST_CONCURRENCY=1
# Root of repository checkout for provider deployments (services/provider_deploy.py).
TNH_REPO_ROOT=
# Master secret used to encrypt/decrypt provider credentials at rest (services/credential_crypto.py).
COMFY_CREDENTIAL_SECRET=

