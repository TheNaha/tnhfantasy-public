# Python environment
PYTHONUNBUFFERED=1

# SQLite Database Location
# For local dev (relative to backend_v2/): sqlite:///./data/db/comfy.db
# For Docker (overridden in docker-compose environment): sqlite:////data/db/comfy.db
COMFY_DATABASE_URL=sqlite:///./data/db/comfy.db

# Data directories (used for local dev; Docker overrides these in docker-compose.yml)
OUTPUT_DIR=./data/output
INPUT_DIR=./data/input

# Preview image cache directory
COMFY_PREVIEW_CACHE_DIR=./data/models/cache

# Uvicorn auto-reload (set to 0 to disable; default is enabled)
# COMFY_UVICORN_RELOAD=1

# Docker network name used for provider container detection
# COMFY_DOCKER_NETWORK=tnhcomfy

# API Tokens (REQUIRED - get these from your accounts)
HF_TOKEN=your_huggingface_token_here
CIVITAI_TOKEN=your_civitai_token_here

# Beam Provider Configuration (optional - only if using Beam)
BEAM_API_KEY=your_beam_api_key_here

# Modal Provider Configuration (REQUIRED for Modal providers)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Backend URL (for providers to communicate back to the backend)
# In Docker compose, this is automatically http://backend_v2:8002
BACKEND_URL=http://backend_v2:8002

# CORS Origins (optional - defaults to ["*"] for development)
# COMFY_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Worker backend URL (used by backend to build provider env vars, optional)
# Default: http://backend_v2:8002
# COMFY_WORKER_BACKEND_URL=http://backend_v2:8002
