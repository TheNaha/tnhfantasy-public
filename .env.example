# Python environment
PYTHONUNBUFFERED=1

# SQLite Database Location
COMFY_DATABASE_URL=sqlite:///./data/comfy.db

# API Tokens
HF_TOKEN=your_huggingface_token_here
CIVITAI_TOKEN=your_civitai_token_here

# Runtime settings
XDG_RUNTIME_DIR=/run

# HOST_BACKEND_PATH: Absolute path to provider_containers on the HOST machine
# Example: /home/user/containers/tnhcomfy/provider_containers
HOST_BACKEND_PATH=/host/containers/tnhcomfy/provider_containers
