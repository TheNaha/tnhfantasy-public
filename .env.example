PYTHONUNBUFFERED=1
POSTGRES_USER=comfy
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=comfy
COMFY_PREVIEW_PREFETCH_ENABLED=true
COMFY_PROVIDER_AUTOSTART_ENABLED=0
# The ONE shared secret for the backend <-> provider relationship.
#
# It authenticates both directions, which is what it always did — there used to
# be two variables for it (PROVIDER_WORKER_TOKEN for backend -> container,
# COMFY_DISCOVERY_TOKEN for container -> backend), and having two was how this
# broke: with the discovery one empty and the management one set, every provider
# failed to register, the log filled with
# `discovery_token_not_configured`, and nothing else looked wrong.
#
#   - backend  -> container : `X-Provider-Token` on inference, model
#                               download/delete, file get/upload, /deploy
#   - container -> backend  : `X-Provider-Token` on self-registration
#
# THIS MUST NOT BE LEFT EMPTY. Both ends fail CLOSED without it: a container with
# an empty token answers 503 on every protected route, and the backend refuses
# unauthenticated provider registration (503, `discovery_token_not_configured`).
# Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# `scripts/preflight.sh` reports this one as UNSET before `compose up`, because a
# provider that cannot register is otherwise only visible in the logs.
COMFY_PROVIDER_TOKEN=

# Whether containers may register NEW provider ids they were not configured with,
# and which hosts they may claim.
COMFY_DISCOVERY_ALLOW_NEW_PROVIDERS=0
COMFY_DISCOVERY_ALLOWED_HOSTS=

# Comma-separated extra hostnames that should receive X-Provider-Token.
# Docker-network providers are matched automatically via the
# tnhcomfy-<provider_id> container-name convention. Add serverless provider
# domains (e.g. a *.modal.run or *.beam.run base URL) here, otherwise the
# backend omits the header and the provider answers 401.
COMFY_WORKER_HOSTS=

COMFY_CORS_ORIGINS=["http://localhost:5174","https://comfy.lan.thenaha.my.id","https://100.150.0.4"]
HF_TOKEN=
CIVITAI_TOKEN=

# Host path of provider_containers/ on the Docker host, used only by the
# backend-driven autostart/deploy path (COMFY_PROVIDER_AUTOSTART_ENABLED=1
# or the provider deploy endpoints). Absolute path, no trailing slash.
HOST_BACKEND_PATH=
HOST_PROVIDER_CONTAINERS_PATH=
