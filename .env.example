# Python environment
PYTHONUNBUFFERED=1

# ============================================================================
# Database
# ============================================================================
# SQLite Database Location
# For local dev (relative to backend_v2/): sqlite:///./data/db/comfy.db
# For Docker (overridden in docker-compose): sqlite:////data/db/comfy.db
# COMFY_DATABASE_URL=sqlite:///./data/db/comfy.db

# ============================================================================
# Data directories
# ============================================================================
# Output and input directories for ComfyUI generations
# OUTPUT_DIR=./data/output
# INPUT_DIR=./data/input

# Preview image cache directory (CivitAI model thumbnails)
# COMFY_PREVIEW_CACHE_DIR=./data/models/cache

# ============================================================================
# Image processing
# ============================================================================
# COMFY_THUMBNAIL_SIZE=512
# COMFY_THUMBNAIL_FORMAT=webp
# COMFY_THUMBNAIL_QUALITY=90

# ============================================================================
# Preview cache prefetch
# ============================================================================
# Enable background warming of CivitAI preview image cache (default: false)
# When enabled, stale previews are refreshed every PREVIEW_PREFETCH_INTERVAL_SECONDS
COMFY_PREVIEW_PREFETCH_ENABLED=true

# How often the preview prefetch cycle runs (seconds, default: 300)
# COMFY_PREVIEW_PREFETCH_INTERVAL_SECONDS=300

# How many stale previews to refresh per cycle (default: 50)
# COMFY_PREVIEW_PREFETCH_MAX_CANDIDATES=50

# Batch size of stale models to fetch per cycle (default: 10)
# COMFY_PREVIEW_PREFETCH_BATCH_SIZE=10

# How long before a cached preview is considered stale (seconds, default: 86400 = 24h)
# COMFY_PREVIEW_PREFETCH_STALE_AFTER_SECONDS=86400

# Cache failure TTL - skip refetching failed previews for this long (seconds, default: 600)
# COMFY_PREVIEW_FAILURE_TTL_SECONDS=600

# Cache not-found TTL - skip previews that returned 404 for this long (seconds, default: 21600 = 6h)
# COMFY_PREVIEW_NOT_FOUND_TTL_SECONDS=21600

# Timeout for fetching CivitAI model metadata (seconds, default: 10.0)
# COMFY_PREVIEW_METADATA_TIMEOUT_SECONDS=10.0

# Timeout for downloading preview images (seconds, default: 30.0)
# COMFY_PREVIEW_IMAGE_TIMEOUT_SECONDS=30.0

# ============================================================================
# Job queue
# ============================================================================
# Max concurrent jobs (default: 5)
# COMFY_MAX_CONCURRENT_JOBS=5

# Job timeout in seconds (default: 300)
# COMFY_JOB_TIMEOUT=300

# Max retries for failed jobs (default: 3)
# COMFY_JOB_MAX_RETRIES=3

# Retry exponential backoff base delay in seconds (default: 1.0)
# COMFY_JOB_RETRY_BASE_DELAY=1.0

# Retry maximum delay in seconds (default: 60.0)
# COMFY_JOB_RETRY_MAX_DELAY=60.0

# ============================================================================
# Model sync & reconciliation
# ============================================================================
# How often to sync model metadata (seconds, default: 300)
# COMFY_MODEL_SYNC_INTERVAL=300

# How often to reconcile provider model directories (seconds, default: 120)
# COMFY_RECONCILIATION_INTERVAL=120

# ============================================================================
# Network & API
# ============================================================================
# Docker network name used for provider container detection
# COMFY_DOCKER_NETWORK=tnhcomfy

# CORS Origins (defaults to ["*"] for development)
# COMFY_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Worker backend URL (used by backend to build provider env vars, optional)
# Default: http://backend_v2:8002
# COMFY_WORKER_BACKEND_URL=http://backend_v2:8002

# Backend URL (for providers to communicate back to the backend)
# In Docker compose, this is automatically http://backend_v2:8002
# BACKEND_URL=http://backend_v2:8002

# Uvicorn auto-reload (set to 0 to disable; default is enabled)
# COMFY_UVICORN_RELOAD=1

# ============================================================================
# API Tokens (REQUIRED - get these from your accounts)
# ============================================================================
# HF_TOKEN=your_huggingface_token_here
# CIVITAI_TOKEN=your_civitai_token_here

# ============================================================================
# Beam Provider (optional - only if using Beam)
# ============================================================================
# BEAM_API_KEY=your_beam_api_key_here

# ============================================================================
# Modal Provider (REQUIRED for Modal providers)
# ============================================================================
# MODAL_TOKEN_ID=your_modal_token_id_here
# MODAL_TOKEN_SECRET=your_modal_token_secret_here
