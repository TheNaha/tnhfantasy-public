{
  "name": "tnhcomfy-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@9.2.0",
  "scripts": {
    "preinstall": "node ./scripts/enforce-npm.cjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --grep-invert @fullstack",
    "test:e2e:fullstack": "playwright test --grep @fullstack"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@xyflow/react": "^12.11.1",
    "blurhash": "^2.0.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.43.0",
    "idb-keyval": "^6.2.5",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.0.4",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "textarea-caret": "^3.1.0",
    "zustand": "^5.0.16"
