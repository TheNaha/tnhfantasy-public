# ===========================================================================
# TTS provider — `tts-modal-hp196`
# ===========================================================================
# A provider container in the same sense as the image and LLM workers: it
# self-registers with the backend by heartbeat, the backend acknowledges and adds
# it to `providers`, and `task_type="tts"` jobs are then routed to it.
#
# Copy the Modal credentials from `.env.modal-hp196` — they are the SAME
# workspace, so `POST /api/v2/providers/tts-modal-hp196/deploy` can build the
# `comfy-modal-tts` app. Nothing here is a new account.
#
# The PROVIDER_ID in docker-compose.yml must start with `tts-`. The backend's
# `_infer_discovery_type` keys off the id, and anything it does not recognise
# falls through to `direct_url`/`image` — which would register this container as
# an image provider and offer it checkpoint jobs it cannot run.

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Shared with every other provider container. Without it the worker answers 503
# on every protected route.
PROVIDER_WORKER_TOKEN=

# Same account as the image providers; used by the worker for its own discovery
# heartbeat. Compose sets it too; the value must match the backend's.
COMFY_DISCOVERY_TOKEN=

# The app this provider deploys and calls. Distinct from the image worker's
# `comfy-modal-stack` so the two deployments keep separate histories and a cold
# start in one does not touch the other.
MODAL_TTS_APP_NAME=comfy-modal-tts

# Shares the volume with the image worker, so a TTS model downloaded once is
# visible to both.
MODAL_VOLUME_NAME=comfy-storage

# Where the TTS model lives. One small directory, versus the 531 files ComfyUI
# enumerates on the image worker's tree at every cold start.
MODAL_TTS_MODEL_DIR=/mnt/data/models/TTS

# 300s, not the image worker's 40s. This runs seconds of speech at a time; a
# cold start is ~44s, so paying that per message would dominate. It still scales
# to zero, so an idle TTS provider costs nothing.
MODAL_TTS_SCALEDOWN=300

# 1, matching the image workers — Modal bills per container-second. Raise for
# concurrent narration.
MODAL_TTS_MAX_CONTAINERS=1

# Generous relative to the image worker's 600s: a batched voice-design run and a
# long narration batch both legitimately take minutes on a cold container.
MODAL_TTS_TIMEOUT=1800

# ComfyUI runs accumulate GPU state — loaded graphs, cached node outputs, leaked
# allocator arenas — and the process is restarted after this many completed runs
# to reclaim it. The image workers use the same counter; keeping it a separate
# knob is deliberate, because a TTS batch is many short runs on one warm
# container and would otherwise restart mid-batch.
MODAL_TTS_MAX_RUNS_BEFORE_RESTART=10

# The Modal class the TTS worker's /files routes call for reads, writes and
# deletes. Named rather than anonymous so a misconfigured deployment fails with
# "no such attribute" on the worker's own class instead of an unbound method.
MODAL_TTS_STORAGE_CLASS=TTSFileStorage

# The Modal GPU. Falls back to MODAL_GPU_TYPE, then L4.
MODAL_TTS_GPU_TYPE=L4
MODAL_TTS_CPU=1
