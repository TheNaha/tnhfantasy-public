{
  "worker": {
    "poll_interval": 0.3,
    "retry_delay": 5,
    "poll_limit": 50
  },
  "jobs": {
    "default_limit": 20,
    "max_in_memory": 100,
    "max_concurrent": 5,
    "timeout": 300,
    "max_retries": 3,
    "retry_base_delay": 1.0,
    "retry_max_delay": 60.0
  },
  "model_sync": {
    "interval": 300,
    "retry_delay": 10,
    "reconciliation_interval": 120
  },
  "downloads": {
    "chunk_size": 8192,
    "auto_remove_delay": 5
  },
  "modal": {
    "timeout": 300,
    "max_containers": 1,
    "scaledown_window": 5
  },
  "api": {
    "gzip_minimum_size": 1000,
    "cors_origins": [
      "*"
    ]
  },
  "jobs_cleanup": {
    "max_age_hours": 24,
    "auto_cleanup": false,
    "cleanup_interval": 3600
  },
  "image_processing": {
    "thumbnail_sizes": {
      "medium": 512
    },
    "thumbnail_format": "webp",
    "thumbnail_quality": 90,
    "thumbnail_directory": "thumb",
    "output_date_hierarchy": true,
    "embed_metadata_in_png": true,
    "blurhash_components_x": 4,
    "blurhash_components_y": 3,
    "blurhash_resize_max": 400
  },
  "generator": {
    "default_checkpoint": "sd_xl_base_1.0.safetensors"
  }
}