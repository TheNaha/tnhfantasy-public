# ---------------------------------------------------------------------------
# Engine-side configuration: the knobs the IN-PROCESS engines and the remote
# agent read, plus the per-provider credential templates.
#
# `.env.example` is the canonical backend reference and covers every `COMFY_*`
# operational knob plus the compose template. This file covers what is
# engine-specific: Modal, Beam, remote-agent, LLM-provider and ComfyUI-direct
# credentials and their env fallbacks. Defaults below are read out of the
# source:
#
#   backend_v2/services/engines/engine_factory.py   (BEAM_*, COMFYUI_*, REMOTE_*)
#   backend_v2/services/engines/modal_engine.py      (MODAL_APP_NAME,
#                                                    MODAL_GET_FILE_TIMEOUT_SECONDS)
#   backend_v2/services/engines/modal_tts_engine.py  (MODAL_TTS_*)
#   backend_v2/services/engines/llm_engine.py        (MODAL_LLM_*,
#                                                    MODAL_GET_FILE_TIMEOUT_SECONDS)
#   backend_v2/services/engines/beam_engine.py       (WS_*, BEAM_*)
#   backend_v2/services/engines/direct_comfy_engine.py (COMFYUI_OBJECT_INFO_CACHE_TTL,
#                                                      REMOTE_HEALTH_PROBE_TIMEOUT)
#   backend_v2/services/in_process_reconciliation.py (RECONCILIATION_DELETE_ORPHANS,
#                                                    MAX_CONCURRENT_DOWNLOADS)
#   backend_v2/services/load_balancer.py             (COMFY_LB_*)
#   remote_agent/server.py                           (REMOTE_AGENT_*, DOWNLOAD_TIMEOUT)
#
# Which variables a provider actually needs depends on ENGINE:
#   modal          -> MODAL_TOKEN_ID / MODAL_TOKEN_SECRET / MODAL_APP_NAME
#   beam           -> BEAM_API_KEY / BEAM_WORKSPACE_ID / BEAM_*_URL
#   remote_comfy   -> REMOTE_AGENT_URL / REMOTE_AGENT_TOKEN
#   direct_url     -> COMFYUI_URL (+ COMFYUI_API_KEY if the rig is authed)
#   openai_compat  -> OPENAI_API_BASE / OPENAI_API_KEY / LLM_MODEL
#   anthropic      -> ANTHROPIC_API_KEY
#   google         -> GOOGLE_API_KEY
#
# Every value below is a placeholder. NEVER put a real credential in an example
# file. `.env.example.provider.engines` is NOT a compose `env_file:` target — the
# stack reads only the root `.env`. This file is the template you
# `cp .env.example.provider.engines .env.<provider_id>` from.
# ---------------------------------------------------------------------------

# ===========================================================================
# Modal (image engine) — services/engines/modal_engine.py
# ===========================================================================
# Credentials for the `modal` CLI, which is what `modal deploy` shells out to.
# Without both of these no image job can be dispatched.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Deployed app name. The engine reaches the deployment through
# `modal.Function.from_name(MODAL_APP_NAME, ...)`, so this must match the app
# `modal deploy` published.
#
# It is DELIBERATELY left commented out, and this is not an oversight. This file
# used to assign `MODAL_APP_NAME=comfy-modal-stack` here AND
# `MODAL_APP_NAME=vllm-modal-stack` in the vLLM section, and the documented
# workflow is `cp .env.example.provider.engines .env.<name>`. There is no include
# mechanism and no per-section scoping in an env file, so every copied file ended
# with the LAST one. A duplicate key is unrecoverable in a copied file — the
# earlier value is simply gone — so both are commented and the operator picks
# exactly one.
#
# Unset is safe: the image engine defaults to `comfy-modal-stack` and the vLLM
# engine to `vllm-modal-stack` (`modal_engine.py`, `llm_engine.py`). An
# EXPLICITLY EMPTY value is not — so if you uncomment one of these, uncomment a
# value, never a bare `MODAL_APP_NAME=`.
#
#   image engine -> comfy-modal-stack
#   vLLM  engine -> vllm-modal-stack
# MODAL_APP_NAME=comfy-modal-stack

# ===========================================================================
# Modal (vLLM / LLM engine) — services/engines/llm_engine.py
# ===========================================================================
# The vLLM deployment publishes under its own app name and class.
#
# EVERY value in this section is also present in the image engine section above,
# for the same duplicate-key reason: keep them commented and set a vLLM value in
# the vLLM provider's own `.env.<name>` file, which has no duplicate to collide
# with.
#   MODAL_APP_NAME  -> vllm-modal-stack  (default when absent)
#   MODAL_LLM_APP_NAME -> vllm-modal-stack
#   MODAL_LLM_CLASS    -> VLLMEngine
# MODAL_LLM_APP_NAME=vllm-modal-stack
# MODAL_LLM_CLASS=VLLMEngine

# ===========================================================================
# Modal (TTS engine) — services/engines/modal_tts_engine.py
# ===========================================================================
# A separate Modal app from the image worker. The class inside it must match the
# deployed app; a rename on one side only fails at the first call, not at import.
# MODAL_TTS_APP_NAME=comfy-modal-tts
# MODAL_TTS_CLASS=TTSWorker
# Modal class that owns the audio volume. Override only if your app names the
# storage class differently; the engine defaults to TTSFileStorage.
# MODAL_TTS_STORAGE_CLASS=TTSFileStorage

# ===========================================================================
# Beam — services/engines/beam_engine.py, engine_factory.py
# ===========================================================================
BEAM_API_KEY=
# Workspace the key belongs to. Sent as X-Beam-Workspace-Id; wrong or missing
# gets every call rejected, so /health answers 503 (a permanent fault).
BEAM_WORKSPACE_ID=

# Deployment URLs the engine talks to. `beam deploy` publishes them; leaving
# BEAM_GPU_URL or BEAM_STORAGE_URL empty makes /health answer 503.
# The download deployment is optional: BEAM_DOWNLOAD_URL falls back to
# BEAM_STORAGE_URL, which is the single-deployment layout.
BEAM_GPU_URL=
BEAM_STORAGE_URL=
BEAM_DOWNLOAD_URL=
# Falls back to BEAM_STORAGE_URL.
BEAM_EXTRACTOR_URL=
# GPU shape the engine advertises to the deployment. RTX4090 | A100 | ...
BEAM_GPU_TYPE=RTX4090

# --- Inference websocket (engines/beam_engine.py) --------------------------
# Largest message the engine will accept on the GPU websocket, in MB. A
# generated image arrives base64-encoded on this socket, so this is the number
# that decides whether a large output silently kills the connection. 20
WS_MAX_SIZE_MB=20
# Seconds allowed for the websocket handshake, which includes a cold start of
# the GPU container. 120
WS_OPEN_TIMEOUT=120

# ===========================================================================
# Modal ranged file reads — modal_engine.py / llm_engine.py
# ===========================================================================
# Ceiling on one /get-file ranged read, in seconds. The read is ~875 RPCs for a
# 7 GB checkpoint and nothing else bounds it: Modal retries a dropped connection,
# so a storage container that never comes back reads as a stream that never
# ends. 3600
MODAL_GET_FILE_TIMEOUT_SECONDS=3600

# Snapshot vs stable class for the Modal image app. When true the engine asks
# for `ComfyUISnapshot`, which keeps the ComfyUI process warm between runs at
# the cost of a larger image. Only read on the Modal image path; every other
# engine ignores it. `false` (the default) uses `ComfyUIStable`.
# ENABLE_MEMORY_SNAPSHOT=false

# ===========================================================================
# Transfer ceilings (engines/base.py)
# ===========================================================================
# Single /get-file transfer ceiling, bytes (0 or less disables). 536870912
PROVIDER_GET_FILE_MAX_BYTES=536870912
# Single /upload-file body ceiling, decoded bytes. 536870912
PROVIDER_UPLOAD_MAX_BYTES=536870912

# Retained fire-and-forget tasks per engine. Past this a download request is
# refused with a retryable 429 instead of growing an unbounded set. 16
PROVIDER_MAX_BACKGROUND_TASKS=16

# Concurrent model downloads during reconciliation. A provider row's
# `max_concurrent_downloads` wins over this. 5
MAX_CONCURRENT_DOWNLOADS=5

# --- object_info cache (direct_comfy_engine.py) ----------------------------
# Seconds a ComfyUI /object_info response is reused before it is re-fetched. 30
COMFYUI_OBJECT_INFO_CACHE_TTL=30

# --- direct_url / remote_comfy health probe ---------------------------------
# Timeout of the upstream /health probe, in seconds. The health check is on the
# dispatch path — it decides whether a provider is eligible for a job — so a
# silent rig must not hold it for long. 1.5
REMOTE_HEALTH_PROBE_TIMEOUT=1.5

# ===========================================================================
# DANGEROUS — arms mass deletion
# ===========================================================================
# When true, reconciliation deletes every file on provider storage that the
# backend has no row for, up to a safety fraction of what exists
# (calculate_safe_deletion_limit). It deletes; it does not quarantine. It runs
# on a timer, on every provider, and treats an empty backend database as
# "everything is an orphan". Point this at a provider whose contents are exactly
# what you want to keep.
#   false | true
RECONCILIATION_DELETE_ORPHANS=false

# ===========================================================================
# Remote agent (remote_agent/server.py) — for remote_comfy providers
# ===========================================================================
# Base URL of the agent, as seen from the backend.
# REMOTE_AGENT_URL=http://host:8001
# Shared secret, compared with hmac.compare_digest. The agent refuses to start
# without it unless REMOTE_AGENT_ALLOW_INSECURE is set.
# REMOTE_AGENT_TOKEN=
# Absolute path of the ComfyUI models directory on the GPU rig. Everything the
# agent serves is inside it.
# DATA_DIR=/home/user/ComfyUI/models
# DANGEROUS: no authentication at all on the agent.
# REMOTE_AGENT_ALLOW_INSECURE=1
# Per-download ceiling on the agent, seconds. Also the HTTP read timeout for
# every download the agent makes — without it `requests.get` blocks forever on a
# peer that accepts the connection and then goes quiet. 1800
# DOWNLOAD_TIMEOUT=1800
# Concurrent `asyncio.to_thread` calls the agent will run, across every route.
# `asyncio.to_thread` uses the default executor, whose worker count is bounded
# but NOT by this number: 16 unbounded /validate-models scans plus a /get-file
# walk plus a download could occupy every thread the single-process agent has
# and stop the rig answering anything at all. 32
# REMOTE_AGENT_THREAD_MAX_CONCURRENT=32
# Concurrent seed downloads during the agent's own /setup. 3
# REMOTE_AGENT_SEED_MAX_CONCURRENT=3
# Ceiling on one /upload-file body, in decoded bytes. Base64 is a JSON *string*
# field, so the whole body is parsed into memory before the handler runs; the
# limit is checked on the declared Content-Length first and on the encoded
# length second. 536870912 (512 MiB)
# REMOTE_AGENT_UPLOAD_MAX_BYTES=536870912

# ===========================================================================
# direct_url — services/engines/direct_comfy_engine.py, engine_factory.py
# ===========================================================================
# Root URL of a ComfyUI instance with no agent sidecar. Defaults to
# http://localhost:8188 when neither the provider row nor this variable sets it.
# COMFYUI_URL=http://localhost:8188
# API key for a rig that sits behind an authenticating reverse proxy. Leave
# empty for a plain local instance.
# COMFYUI_API_KEY=
# Seconds allowed for each of the two concurrent /health probes. 1.5
# COMFYUI_HEALTH_PROBE_TIMEOUT=1.5

# ===========================================================================
# LLM engines — REQUIRED keys, per section
# ===========================================================================
# The lines below are commented out, which is a trap for `openai_compat` and
# nothing else: a copied file therefore has NO OPENAI_API_BASE, and the engine
# falls back to `http://localhost:11434/v1` (Ollama) — so the provider registers,
# reports healthy, and every chat is answered by whatever Ollama happens to be
# running, or refused if Ollama is not.
#
# Set at least OPENAI_API_BASE and OPENAI_API_KEY to use this engine.
#
# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, OpenRouter, ...).
# REQUIRED.
# OPENAI_API_BASE=http://localhost:11434/v1
# REQUIRED — a placeholder key is fine for a local endpoint that ignores auth;
# a real one is required for a hosted provider. Never put a real key here.
# OPENAI_API_KEY=
# Used when a request names no model. default-model
# LLM_MODEL=default-model
# REQUIRED for this engine. There is no fallback: without it /health reports the
# provider unconfigured and the dispatcher will not send it a job.
# ANTHROPIC_API_KEY=
# Sent as the x-goog-api-key header, never in a URL. REQUIRED for this engine —
# without it, list_models returns a hard-coded fallback list and every inference
# is refused upstream, while the provider still looks healthy.
# GOOGLE_API_KEY=

# ===========================================================================
# Discovery / auth (see .env.example for the full shared contract)
# ===========================================================================
# One shared secret authenticates both the backend -> engine and the
# engine -> backend directions. It MUST NOT be left empty: both ends fail
# CLOSED without it. Read at infrastructure/http_client.py and
# remote_agent/server.py.
# COMFY_PROVIDER_TOKEN=
# Hosts the backend must NOT send the shared token to. Unset means no
# restriction.
# COMFY_WORKER_HOSTS=

# --- Worker-transport engine tuning (backend_v2) --------------------------
# These are read by the in-process engines for the Beam / Remote / Direct cells
# of the provider matrix (see services/engines/worker_transport_engines.py).

# Service token a self-hosted container presents for the `remote` transport.
# Same header the image-agent sidecar validates, so one token per rig can serve
# both. AGENT_URL is the matching URL.
AGENT_TOKEN=
AGENT_URL=http://gpu-box:8001

# Default voice for a self-hosted TTS container when a request does not name
# one. Empty means the request must name it (default: none).
# TTS_DEFAULT_VOICE=af_bella

# Ceiling on one remote-LLM request, seconds. Bounds how long the engine waits
# for the FIRST byte of the SSE stream; the container's own per-request timeout
# is the other half (default 600).
# REMOTE_LLM_STREAM_TIMEOUT_SECONDS=600

# Ceiling on one synthesised clip, decoded bytes. Bounded because the clip is
# fetched back through get_file_stream under the shared read cap, and a
# container that returns a 4 GiB body should not fill the backend's memory
# before that cap is consulted (default 536870912, 512 MiB).
# REMOTE_TTS_MAX_BODY_BYTES=536870912
