# ---------------------------------------------------------------------------
# Engine-side configuration: the knobs the DEPLOYED Modal / Beam images read,
# plus the shared worker contract that `.env.example.provider` never covered.
#
# `.env.example.provider` holds the short list of API tokens. It is unchanged
# by this file; this is the full reference, with the real defaults read out of
# the source:
#
#   image_worker/engines/modal/modal_app.py    (MODAL_*)
#   image_worker/engines/beam/beam_app.py      (BEAM_*)
#   image_worker/engines/beam/client.py        (BEAM_*_URL, WS_*)
#   llm_worker/engines/modal/modal_app.py      (MODAL_* for the vLLM engine)
#   image_worker/worker.py                     (timeouts, reconciliation)
#   remote_agent/server.py                     (REMOTE_AGENT_*)
#   provider_core/{reconciliation,background,http_client,deploy}.py
#
# Which variables a provider actually needs depends on ENGINE:
#   modal          -> MODAL_*
#   beam           -> BEAM_*
#   remote_comfy   -> see .env.example.remote-comfy
#   direct_url     -> see .env.example.direct-url
#   openai_compat  -> OPENAI_API_BASE / OPENAI_API_KEY / LLM_MODEL
#   anthropic      -> ANTHROPIC_API_KEY
#   google         -> GOOGLE_API_KEY
#
# Values below are placeholders. NEVER put a real credential in an example file.
# ---------------------------------------------------------------------------

# ===========================================================================
# Modal (image engine) — image_worker/engines/modal/modal_app.py
# ===========================================================================
# Credentials for the `modal` CLI, which is what `modal deploy` shells out to.
# Without both of these, /deploy fails and no image job can be dispatched.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Deployed app name. The worker reaches the deployment through
# `modal.Function.from_name(MODAL_APP_NAME, ...)`, so this must match the app
# `modal deploy` published.
#
# It is DELIBERATELY left commented out, and this is not an oversight. This file
# used to assign `MODAL_APP_NAME=comfy-modal-stack` here AND
# `MODAL_APP_NAME=vllm-modal-stack` in the vLLM section 55 lines down, and the
# documented workflow is `cp .env.example.provider.engines .env.<name>`. There is
# no include mechanism and no per-section scoping in an env file, so every copied
# file ended with the LAST one: a Modal IMAGE provider resolved
# `modal.Function.from_name("vllm-modal-stack", "setup_models")`, found the LLM
# app's `comfy-llm-models` volume, and listed and downloaded LLM files as if they
# were checkpoints. A duplicate key is unrecoverable in a copied file — the
# earlier value is simply gone — so both are commented and the operator picks
# exactly one.
#
# Unset is safe: the worker defaults per engine
# (`os.getenv("MODAL_APP_NAME", "comfy-modal-stack")` in
# image_worker/engines/modal/client.py, `"vllm-modal-stack"` in
# llm_worker/engines/modal/client.py). An EXPLICITLY EMPTY value is not — the
# image engine's /health answers 503 for it, as a permanent configuration fault
# the dispatcher is told not to retry. So if you uncomment one of these, uncomment
# a value, never a bare `MODAL_APP_NAME=`.
#
#   image engine -> comfy-modal-stack
#   vLLM  engine -> vllm-modal-stack
# MODAL_APP_NAME=comfy-modal-stack

# Account the deployment belongs to, surfaced on /info.
MODAL_USERNAME=

# Persistent volume holding the models. Must be the same name for the GPU, the
# download and the storage classes or they see different disks.
#
# Commented out for the same reason as MODAL_APP_NAME above: the vLLM section
# below also lists it, with a DIFFERENT value, so whichever block a copied file
# kept decided which disk the provider used. Absent is correct for both — the
# image engine defaults to `comfy-storage` (modal_app.py:416) and the vLLM engine
# to `comfy-llm-models` (llm_worker modal_app.py:39) — so this only needs a value
# if your volume is named something else. Uncomment a value, never a bare
# `MODAL_VOLUME_NAME=`.
# MODAL_VOLUME_NAME=comfy-storage

# --- GPU class ---------------------------------------------------------
# L4 | A100 | A10G | H100 ...
MODAL_GPU_TYPE=L4
MODAL_GPU_CPU=2
MODAL_GPU_TIMEOUT=600
# Concurrent GPU containers. 1 means a second job queues rather than running on
# a second rented GPU.
MODAL_GPU_MAX_CONTAINERS=1
# Seconds of idle before the GPU container is scaled down. 0 disables scaling
# down entirely (maximum cost, minimum cold start).
MODAL_GPU_SCALEDOWN=40
# Same, for the snapshot container. 0 disables it.
MODAL_GPU_SCALEDOWN_SNAPSHOT=40

# --- ComfyUI inside the GPU container ----------------------------------
# Seconds without progress before the run is treated as hung. 300
MODAL_COMFYUI_STALL_TIMEOUT_SECONDS=300
# Timeout of ComfyUI's own startup healthcheck inside the container. 180
MODAL_COMFYUI_HEALTHCHECK_TIMEOUT_SECONDS=180
# Restart ComfyUI after this many generations. 10 — a margin below the ~15-run
# hang that was observed in practice.
MODAL_COMFYUI_MAX_RUNS_BEFORE_RESTART=10
# true | false — capture a stack trace when a stall is detected.
MODAL_COMFYUI_CAPTURE_STALL_DIAGNOSTICS=true
# Ceiling on that captured trace, in seconds and characters. 8 / 12000
MODAL_COMFYUI_STALL_DIAGNOSTICS_TIMEOUT_SECONDS=8
MODAL_COMFYUI_STALL_DIAGNOSTICS_MAX_CHARS=12000

# --- Download class ----------------------------------------------------
MODAL_DOWNLOAD_TIMEOUT=3600
MODAL_DOWNLOAD_MAX_CONTAINERS=5
MODAL_DOWNLOAD_CPU=2.0

# --- Storage class -----------------------------------------------------
MODAL_STORAGE_TIMEOUT=300
MODAL_STORAGE_MAX_CONTAINERS=1
MODAL_STORAGE_SCALEDOWN=5

# --- Validation class --------------------------------------------------
MODAL_VALIDATE_TIMEOUT=600
MODAL_VALIDATE_MAX_CONTAINERS=1

# ===========================================================================
# Modal (LLM / vLLM engine) — llm_worker/engines/modal/modal_app.py
# ===========================================================================
# The vLLM deployment publishes under its own app name and its own volume.
#
# EVERY value in this section is also present in the image engine section above,
# and four of them differ. An env file holds one value per key with no include
# mechanism and no per-section scoping, and the documented workflow is
# `cp .env.example.provider.engines .env.<name>` — so a copied file silently took
# this section's values for the image engine too (10 storage containers instead
# of 1, 2 download containers instead of 5, 2 validation containers instead of 1,
# and the vLLM app name and volume). The whole section is therefore commented
# out, so a copy is correct-by-default for BOTH engines and nothing here can
# override anything above.
#
# To use one of these: delete the same key from the image engine section, then
# uncomment the vLLM line here. To set a vLLM value without touching the image
# section at all, put it in the vLLM provider's own `.env.<name>` file instead —
# a separate file has no duplicate to collide with.
#
#   MODAL_APP_NAME             -> vllm-modal-stack  (default when absent)
#   MODAL_VOLUME_NAME          -> comfy-llm-models  (default when absent)
#   MODAL_DOWNLOAD_TIMEOUT     -> 3600
#   MODAL_DOWNLOAD_MAX_CONTAINERS -> 2   (image engine: 5)
#   MODAL_STORAGE_MAX_CONTAINERS   -> 10 (image engine: 1)
#   MODAL_VALIDATE_TIMEOUT     -> 600
#   MODAL_VALIDATE_MAX_CONTAINERS  -> 2 (image engine: 1)
# MODAL_APP_NAME=vllm-modal-stack
# MODAL_VOLUME_NAME=comfy-llm-models
# MODAL_DOWNLOAD_TIMEOUT=3600
# MODAL_DOWNLOAD_MAX_CONTAINERS=2
# MODAL_STORAGE_MAX_CONTAINERS=10
# MODAL_VALIDATE_TIMEOUT=600
# MODAL_VALIDATE_MAX_CONTAINERS=2

# ===========================================================================
# Beam — image_worker/engines/beam/beam_app.py and engines/beam/client.py
# ===========================================================================
BEAM_API_KEY=
# Workspace the key belongs to. Sent as X-Beam-Workspace-Id; wrong or missing
# gets every call rejected, so /health answers 503 (a permanent fault).
BEAM_WORKSPACE_ID=

# Persistent volume holding the models.
BEAM_VOLUME_NAME=comfy-storage

# Deployment URLs the worker talks to. `beam deploy` publishes them; leaving
# them empty makes /health answer 503.
# The download deployment is optional: BEAM_DOWNLOAD_URL falls back to
# BEAM_STORAGE_URL, which is the single-deployment layout.
BEAM_GPU_URL=
BEAM_STORAGE_URL=
BEAM_DOWNLOAD_URL=
# Falls back to BEAM_STORAGE_URL.
BEAM_EXTRACTOR_URL=

# --- GPU class ---------------------------------------------------------
BEAM_GPU_TYPE=RTX4090
BEAM_GPU_CPU=2
BEAM_GPU_MEMORY=16Gi
BEAM_GPU_TIMEOUT=600
BEAM_GPU_KEEP_WARM=40
BEAM_GPU_CONCURRENT=1

# --- Storage class -----------------------------------------------------
BEAM_STORAGE_CPU=3
BEAM_STORAGE_MEMORY=4Gi
BEAM_STORAGE_TIMEOUT=600
BEAM_STORAGE_KEEP_WARM=10
BEAM_STORAGE_CONCURRENT=10
BEAM_STORAGE_MAX_CONTAINERS=1

# --- Download class ----------------------------------------------------
BEAM_DOWNLOAD_CPU=2
BEAM_DOWNLOAD_MEMORY=4Gi
BEAM_DOWNLOAD_TIMEOUT=1800
BEAM_DOWNLOAD_KEEP_WARM=5
BEAM_DOWNLOAD_CONCURRENT=5
BEAM_DOWNLOAD_MAX_CONTAINERS=3

# --- Inference websocket (engines/beam/client.py) ----------------------
# Largest message the worker will accept on the GPU websocket, in MB. A
# generated image arrives base64-encoded on this socket, so this is the number
# that decides whether a large output silently kills the connection. 20
WS_MAX_SIZE_MB=20
# Seconds allowed for the websocket handshake, which includes a cold start of
# the GPU container. 120
WS_OPEN_TIMEOUT=120

# ===========================================================================
# Shared worker behaviour (image_worker/worker.py)
# ===========================================================================
# Seconds a single /inference may run. 3600
INFERENCE_TIMEOUT_SECONDS=3600
# Ceiling on a /validate-models call. 300
VALIDATION_TIMEOUT_SECONDS=300
# Per-directory ceiling when listing for reconciliation. 3600
RECONCILIATION_LIST_TIMEOUT_SECONDS=3600
# Concurrent downloads during reconciliation. 5
MAX_CONCURRENT_DOWNLOADS=5
# Seconds between reconciliation triggers. 7200 (2 hours)
RECONCILIATION_INTERVAL_SECONDS=7200
# Delay before the first one after boot. 130
RECONCILIATION_STARTUP_DELAY_SECONDS=130

# Retained fire-and-forget tasks per worker. Past this a download request is
# refused with a retryable 429 instead of growing an unbounded set. 16
PROVIDER_MAX_BACKGROUND_TASKS=16

# Single /get-file transfer ceiling, bytes (0 or less disables). 536870912
PROVIDER_GET_FILE_MAX_BYTES=536870912
# Retained `modal deploy` / `beam deploy` output, bytes (tail kept). 262144
DEPLOY_LOG_MAX_BYTES=262144

# ===========================================================================
# DANGEROUS — arms mass deletion
# ===========================================================================
# When true, reconciliation deletes every file on provider storage that the
# backend has no row for, up to a safety fraction of what exists
# (calculate_safe_deletion_limit in provider_core/reconciliation.py). It
# deletes; it does not quarantine. It runs on a timer, on every provider, and
# treats an empty backend database as "everything is an orphan". Point this at
# a provider whose contents are exactly what you want to keep.
#   false | true
RECONCILIATION_DELETE_ORPHANS=false

# ===========================================================================
# Remote agent (remote_agent/server.py)
# ===========================================================================
# Base URL of the agent, as seen from the remote_comfy worker.
# REMOTE_AGENT_URL=http://host:8001
# Shared secret, compared with hmac.compare_digest. The agent refuses to start
# without it unless REMOTE_AGENT_ALLOW_INSECURE is set.
# REMOTE_AGENT_TOKEN=
# Absolute path of the ComfyUI models directory on the GPU rig. Everything the
# agent serves is inside it.
# DATA_DIR=/home/user/ComfyUI/models
# DANGEROUS: no authentication at all on the agent.
# REMOTE_AGENT_ALLOW_INSECURE=1
# Per-download ceiling on the agent, seconds. 1800
# DOWNLOAD_TIMEOUT=1800

# ===========================================================================
# LLM engines
# ===========================================================================
# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, OpenRouter, ...).
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=
# Used when a request names no model. default-model
# LLM_MODEL=default-model
# ANTHROPIC_API_KEY=
# Sent as the x-goog-api-key header, never in a URL. Without it list_models
# returns a hard-coded fallback list.
# GOOGLE_API_KEY=

# ===========================================================================
# Discovery / auth (see .env.example for the full shared contract)
# ===========================================================================
# PROVIDER_WORKER_TOKEN=
# COMFY_DISCOVERY_TOKEN=
# COMFY_WORKER_HOSTS=
