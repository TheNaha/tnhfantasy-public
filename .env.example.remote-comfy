# ---------------------------------------------------------------------------
# remote_comfy provider environment (the ComfyUI-side worker)
#
# docker-compose.yml has the `provider-remote-comfy` service COMMENTED OUT but
# present, with `env_file: - .env.remote-comfy`. Uncomment the whole block
# (it and the `remote-agent` service below it) to use this file, then:
#
#     cp .env.example.remote-comfy .env.remote-comfy
#
# The architecture: a `remote_agent` runs on the machine that owns the ComfyUI
# models and exposes an authenticated HTTP API over DATA_DIR. This worker runs
# in the orchestrator stack and proxies the backend's requests to that agent, so
# the backend can list, download, validate and delete models on a disk it has
# no other route to.
#
# The agent's own variables (DATA_DIR, REMOTE_AGENT_TOKEN, PORT) are listed at
# the bottom; they are read by the AGENT, not by this worker.
#
# Values below are placeholders. NEVER put a real credential in an example file.
# ---------------------------------------------------------------------------

# Identity. compose sets these in the service `environment:` block (which wins
# over this file); repeated here so the file stands alone.
PROVIDER_ID=remote-comfy
PORT=8000
BACKEND_URL=http://backend_v2:8002
ENGINE=remote_comfy

# ---------------------------------------------------------------------------
# Required: the ComfyUI server this provider drives
# ---------------------------------------------------------------------------
# Base URL of the remote ComfyUI instance. Used for /object_info, /interrupt
# and inference. Reached from the worker container, so it must be routable from
# there, not just from the machine running compose.
COMFYUI_URL=http://192.168.1.50:8188

# Optional. Sent as `Authorization: Bearer <key>` on every ComfyUI request.
COMFYUI_API_KEY=

# ---------------------------------------------------------------------------
# Required: the remote agent
# ---------------------------------------------------------------------------
# Base URL of the remote_agent, including the port it listens on (8001 by
# default). The worker calls /setup, /list-models, /download-model,
# /delete-model, /delete-file, /upload-file, /validate-models,
# /validate-all-models and /get-file on it.
REMOTE_AGENT_URL=http://192.168.1.50:8001

# Required unless the agent runs with REMOTE_AGENT_ALLOW_INSECURE=1.
# Must be byte-identical to the REMOTE_AGENT_TOKEN on the agent: it is sent as
# `Authorization: Bearer <token>` on every agent call, and without it the agent
# answers 401 and every management operation fails while inference still works
# (which is a confusing way to discover a missing secret).
REMOTE_AGENT_TOKEN=

# ---------------------------------------------------------------------------
# Model sources
# ---------------------------------------------------------------------------
HF_TOKEN=
CIVITAI_TOKEN=

# ---------------------------------------------------------------------------
# Timeouts and worker behaviour (image_worker/worker.py)
# ---------------------------------------------------------------------------
# Read as COMFYUI_TIMEOUT_SECONDS at
# `provider_containers/image_worker/worker.py:70`. This file previously said
# INFERENCE_TIMEOUT_SECONDS, which no code reads.
# COMFYUI_TIMEOUT_SECONDS=3600
VALIDATION_TIMEOUT_SECONDS=300
RECONCILIATION_LIST_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_DOWNLOADS=5
RECONCILIATION_INTERVAL_SECONDS=7200
RECONCILIATION_STARTUP_DELAY_SECONDS=130
PROVIDER_MAX_BACKGROUND_TASKS=16
PROVIDER_GET_FILE_MAX_BYTES=536870912
DEPLOY_LOG_MAX_BYTES=262144

# ---------------------------------------------------------------------------
# DANGEROUS — arms mass deletion
# ---------------------------------------------------------------------------
# When true, reconciliation DELETES files on the provider storage that the
# backend has no record of, up to a safety fraction of what exists. It deletes
# rather than quarantines, and it runs on a timer. Leave false until the
# agent's DATA_DIR contains exactly what you want kept.
RECONCILIATION_DELETE_ORPHANS=false

# ---------------------------------------------------------------------------
# Auth shared with the backend
# ---------------------------------------------------------------------------
# Injected by compose from the root .env; overrides anything set here.
# PROVIDER_WORKER_TOKEN gates every state-touching route. Empty means the worker
# answers 503 on all of them, permanently and without retrying.
PROVIDER_WORKER_TOKEN=
COMFY_DISCOVERY_TOKEN=

# ---------------------------------------------------------------------------
# Variables read by the AGENT (remote_agent/), not by this worker
# ---------------------------------------------------------------------------
# Remote agent bind port. 8001
# PORT=8001
# Bind address. 0.0.0.0
# HOST=0.0.0.0

# Agent storage root — the absolute path of the ComfyUI models directory on the
# GPU rig. remote_agent/docker-compose.yml requires it (`:?`) and mounts it at
# /app/remote_agent/data. It is a security boundary: get_safe_path refuses
# anything that resolves outside it, and every /get-file is served from it.
# DATA_DIR=/home/user/ComfyUI/models

# Agent shared secret, checked with hmac.compare_digest. The agent refuses to
# start without it unless REMOTE_AGENT_ALLOW_INSECURE is set.
# REMOTE_AGENT_TOKEN=

# DANGEROUS: start the agent with NO authentication at all. Every route except
# /health becomes reachable by anything that can reach the port, including
# /delete-model, /delete-file and /get-file. Only for a machine with no other
# network path in, and never for a routable address.
#   1 | true | yes
# REMOTE_AGENT_ALLOW_INSECURE=

# Per-download ceiling on the agent, in seconds. 1800
# DOWNLOAD_TIMEOUT=1800
# HF_TOKEN=
# CIVITAI_TOKEN=

# See .env.example for the shared backend<->provider contract and
# .env.example.provider.engines for the Modal/Beam engine knobs.
