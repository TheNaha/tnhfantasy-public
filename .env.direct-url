# Direct URL Provider Configuration (OPTIONAL)
# Uncomment the provider-direct-url block in docker-compose.yml to use this provider.
# Direct URL providers connect to an externally-hosted ComfyUI/HTTP image endpoint.
# PROVIDER_ID=direct-url
# BACKEND_URL=http://backend_v2:8002
# ENGINE=direct_url
# COMFYUI_URL=https://your-comfyui-instance.example.com
# COMFYUI_API_KEY=your-api-key-here
