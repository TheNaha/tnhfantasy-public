# Root-anchored, so this only excluded `.env` at the repository root.
# `remote_agent/docker-compose.yml` builds with `context: ..` and its Dockerfile
# does `COPY remote_agent/ /app/remote_agent/`, so `remote_agent/.env.agent` — the
# file `docs/deployment.md` tells you to create, holding a live
# `REMOTE_AGENT_TOKEN` — was being baked into an image layer. `.gitignore`
# covers it for git and gitleaks, which is precisely why the leak path was
# invisible: only the image was affected. `**/.env*` is the pattern that also
# matches nested paths.
**/.env*
!.env.example
!.env.example.*
!**/.env.example
!**/.env.example.*
data/
output/
input/
**/__pycache__/
**/*.pyc
.git/
.gitignore

# Dependency trees. `remote_agent/docker-compose.yml` builds with `context: ..`,
# so without these the whole repo — including multi-GB venvs and node_modules —
# is shipped to the daemon on every remote-agent build, while the Dockerfile only
# needs remote_agent/ and provider_containers/provider_core/.
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/

# Build/test artifacts
dist/
**/dist/
# PyInstaller output from a local `build-agent-binaries` run, and Vite's dep
# pre-bundle. Neither is an input to any image: the agent image *produces* the
# binary, and the frontend image runs `npm run build` inside the container.
#
# Measured with these absent: 57.9 MB build context, of which 22.2 MB was
# `remote_agent/build/.../tnhcomfy-agent.pkg`, 6.6 MB `PYZ-00.pyz` and 3.1 MB
# `frontend_v2/.vite/deps/*.map` — 44 MB of 58 MB shipped to the daemon on every
# remote-agent build so it could be discarded at the first instruction.
remote_agent/build/
**/build/
.vite/
**/.vite/
test-results/
**/test-results/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
coverage/
**/coverage/
*.log
