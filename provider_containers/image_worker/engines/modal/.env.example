# Example environment file for Modal Worker Container
# Copy this to .env.modal1, .env.modal2, etc. and fill in your credentials

# Modal API Credentials (REQUIRED)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Modal Configuration
MODAL_USERNAME=your_modal_username_here
MODAL_APP_NAME=your_modal_app_name

# Provider Configuration
PROVIDER_ID=modal-primary
PORT=8000
