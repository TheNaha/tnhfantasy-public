# Beam Provider Worker Environment Variables
# Copy to .env.beam and fill in your values

# Required: Beam API Key
BEAM_API_KEY=your-beam-api-key

# Optional: Beam Workspace ID
BEAM_WORKSPACE_ID=

# Provider identification
PROVIDER_ID=beam-worker

# GPU Type used in Beam
BEAM_GPU_TYPE=RTX4090

# ============================================
# Beam Endpoint URLs (from beam deploy output)
# ============================================
# GPU endpoint for inference (expensive - RTX4090)
# Deploy: beam deploy beam_app.py:comfy_gpu --name comfy-gpu --gpu RTX4090 --memory 16000
BEAM_GPU_URL=

# Storage endpoint for file operations (cheap - CPU only)  
# Deploy: beam deploy beam_app.py:comfy_storage --name comfy-storage --memory 4000
BEAM_STORAGE_URL=

# ============================================
# Download tokens (optional)
# ============================================
HF_TOKEN=
CIVITAI_TOKEN=

# Backend URL (for callbacks)
BACKEND_URL=http://comfy-backend-v2:8002
